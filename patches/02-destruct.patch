+static DestructMaterial destructMaterialFrom(int material)
+{
+    switch (material) {
+    case MATERIAL_TYPE_GLASS:
+        return DESTRUCT_GLASS;
+    case MATERIAL_TYPE_METAL:
+    case MATERIAL_TYPE_PLASTIC:
+        return DESTRUCT_METAL;
+    case MATERIAL_TYPE_WOOD:
+        return DESTRUCT_WOOD;
+    case MATERIAL_TYPE_LEATHER:
+        return DESTRUCT_CLOTH;
+    default:
+        return DESTRUCT_STONE;
+    }
+}
