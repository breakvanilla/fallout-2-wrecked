+static bool destructFlashRect(Rect* rect)
+{
+    int x;
+    int y;
+    if (gFlashTile == -1 || !destructTileCenter(gFlashTile, gFlashElevation, &x, &y)) {
+        return false;
+    }
+    int radiusX = (int)gFlashRadius;
+    int radiusY = (int)(gFlashRadius * 0.62f);
+    y -= 14;
+    rect->left = x - radiusX;
+    rect->right = x + radiusX;
+    rect->top = y - radiusY;
+    rect->bottom = y + radiusY;
+    return true;
+}
+
+void destructRenderOverlay(Rect* rect, int elevation)
+{
+    if (!gDestructInitialized || gFlashTile == -1 || gFlashElevation != elevation || gFlashAge >= kFlashTime) {
+        return;
+    }
+
+    Rect flashRect;
+    Rect clipped;
+    if (!destructFlashRect(&flashRect) || !destructClip(&flashRect, rect, &clipped)) {
+        return;
+    }
+
+    float centerX = (flashRect.left + flashRect.right) / 2.0f;
+    float centerY = (flashRect.top + flashRect.bottom) / 2.0f;
+    float radiusX = (flashRect.right - flashRect.left) / 2.0f + 0.5f;
+    float radiusY = (flashRect.bottom - flashRect.top) / 2.0f + 0.5f;
+    float strength = 1.0f - gFlashAge / kFlashTime;
+    strength *= strength;
+    for (int y = clipped.top; y <= clipped.bottom; y++) {
+        unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+        float dy = (y - centerY) / radiusY;
+        for (int x = clipped.left; x <= clipped.right; x++) {
+            float dx = (x - centerX) / radiusX;
+            float distance = dx * dx + dy * dy;
+            if (distance >= 1.0f || dest[x] >= kGlowStart) {
+                continue;
+            }
+            // Dithered, so that the light fades out without rings.
+            int level = 128 + (int)(80.0f * strength * (1.0f - distance) + kBayer[y & 3][x & 3] / 4.0f);
+            dest[x] = intensityColorTable[dest[x]][std::min(level, 255)];
+        }
+    }
+}
+
+void destructShakeOffset(int* x, int* y)
+{
+    *x = 0;
+    *y = 0;
+    if (gShakeAmplitude <= 0.0f) {
+        return;
+    }
+
+    float t = (SDL_GetTicks() - gShakeStart) / 1000.0f;
+    if (t >= kShakeTime) {
+        gShakeAmplitude = 0.0f;
+        return;
+    }
+
+    float amplitude = gShakeAmplitude * (1.0f - t / kShakeTime) * (1.0f - t / kShakeTime);
+    *x = (int)lroundf(amplitude * sinf(t * 71.0f));
+    *y = (int)lroundf(amplitude * 0.6f * cosf(t * 57.0f));
+}
