+// Moves the beam on and sets off what it does; adds what to redraw.
+static void destructBeamStep(float dt, Rect* dirty, bool* anyDirty)
+{
+    auto addDirty = [&](const Rect& rect) {
+        if (*anyDirty) {
+            rectUnion(dirty, &rect, dirty);
+        } else {
+            *dirty = rect;
+            *anyDirty = true;
+        }
+    };
+
+    if (gBeam.hasDrawn && gBeam.elevation == gElevation) {
+        addDirty(gBeam.drawn);
+    }
+
+    gBeam.age += dt;
+    float fireStart = kBeamAim + kBeamCharge;
+    float fireEnd = fireStart + kBeamFire;
+    if (gBeam.age >= fireEnd + kBeamFade || gBeam.elevation != gElevation) {
+        gBeam.active = false;
+        gBeam.hasDrawn = false;
+        return;
+    }
+
+    int pointX;
+    int pointY;
+    if (!destructBeamPoint(&pointX, &pointY)) {
+        gBeam.active = false;
+        return;
+    }
+
+    // Onto a roof and off it quickly but not at once.
+    {
+        float lift = destructRoofLift(pointX, pointY, gBeam.elevation);
+        float step = 900.0f * dt;
+        gBeam.lift = gBeam.lift < lift ? std::min(lift, gBeam.lift + step) : std::max(lift, gBeam.lift - step);
+    }
+
+    bool firing = gBeam.age >= fireStart && gBeam.age < fireEnd;
+    if (firing) {
+        if (gBeam.sounds == 0 || (gBeam.sounds == 1 && gBeam.age >= fireStart + 0.9f)) {
+            destructBeamSound("wam1xxx1");
+            gBeam.sounds++;
+        }
+
+        // It follows the cursor, slowly, as if dragged across the ground.
+        int mouseX;
+        int mouseY;
+        bool steered = gBeam.steerTile != -1 && destructTileCenter(gBeam.steerTile, gBeam.elevation, &mouseX, &mouseY);
+        if (steered || destructCursorGround(&mouseX, &mouseY, gBeam.elevation)) {
+            {
+                float dx = (float)(mouseX - pointX);
+                float dy = (float)(mouseY - pointY) * 2.0f;
+                float length = sqrtf(dx * dx + dy * dy);
+                float step = kBeamSpeed * dt;
+                if (length > 1.0f) {
+                    float move = std::min(step, length) / length;
+                    gBeam.x += dx * move;
+                    gBeam.y += dy * move * 0.5f;
+                }
+            }
+        }
+
+        int tile = destructBeamTile();
+        if (tile != -1) {
+            // It lights everything around it.
+            gFlashTile = tile;
+            gFlashElevation = gBeam.elevation;
+            gFlashAge = 0.04f;
+            gFlashRadius = 70.0f;
+            gFlashDirty = true;
+
+            if (gDestructConfig.shake) {
+                gShakeStart = SDL_GetTicks();
+                gShakeAmplitude = std::max(gShakeAmplitude, 1.6f);
+            }
+
+            if (gBeam.age >= gBeam.nextBlast) {
+                gBeam.nextBlast += kBeamBlastEvery;
+                destructBeamSound("whn1xxx1");
+                // It burns through roofs on its way down.
+                if (!destructMapBlocked()) {
+                    destructBreakRoof(tile, gBeam.elevation, pointX, pointY, 34.0f, 1.2f, dirty, anyDirty);
+                }
+                gBeamBlasts.push_back({ tile, gBeam.elevation });
+            }
+
+            // Sparks thrown up where it touches the ground.
+            int centerX;
+            int centerY;
+            if (destructTileCenter(tile, gBeam.elevation, &centerX, &centerY)) {
+                int sparks = 2 + destructPick(3);
+                for (int index = 0; index < sparks; index++) {
+                    Particle spark = destructNewParticle(PARTICLE_SPARK, tile, gBeam.elevation);
+                    spark.variant = destructPick(5);
+                    spark.x = (float)(pointX - centerX) + destructBetween(-4.0f, 4.0f);
+                    spark.y = (float)(pointY - centerY) + destructBetween(-2.0f, 2.0f);
+                    spark.z = gBeam.lift + destructBetween(1.0f, 6.0f);
+                    float angle = destructBetween(0.0f, 6.2831853f);
+                    float speed = destructBetween(60.0f, 200.0f);
+                    spark.vx = cosf(angle) * speed;
+                    spark.vy = sinf(angle) * speed * 0.5f;
+                    spark.vz = destructBetween(120.0f, 320.0f);
+                    spark.life = destructBetween(0.3f, 0.8f);
+                    destructAddParticle(std::move(spark));
+                }
+            }
+        }
+    }
+
+    Rect rect;
+    if (destructBeamRect(&rect)) {
+        gBeam.drawn = rect;
+        gBeam.hasDrawn = true;
+        if (gBeam.elevation == gElevation) {
+            addDirty(rect);
+        }
+    }
+}
