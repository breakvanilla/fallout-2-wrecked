+// The floor art's pixel at a point of the iso window, 0 where there is none.
+static unsigned char destructFloorPixel(int x, int y, int elevation)
+{
+    int square = squareTileFromScreenXY(x, y, elevation);
+    if (square == -1) {
+        return 0;
+    }
+
+    const int candidates[5] = { square, square + 1, square - 1, square + SQUARE_GRID_WIDTH, square - SQUARE_GRID_WIDTH };
+    for (int candidate : candidates) {
+        if (candidate < 0 || candidate >= SQUARE_GRID_SIZE) {
+            continue;
+        }
+
+        int id = _square[elevation]->field_0[candidate] & 0xFFFF;
+        if ((id & 0x1000) != 0 || (id & 0xFFF) <= 1) {
+            continue;
+        }
+
+        int floorX;
+        int floorY;
+        if (squareTileToScreenXY(candidate, &floorX, &floorY, elevation) != 0) {
+            continue;
+        }
+
+        CacheEntry* handle;
+        Art* art = artLock(buildFid(OBJ_TYPE_TILE, id & 0xFFF, 0, 0, 0), &handle);
+        if (art == nullptr) {
+            continue;
+        }
+
+        unsigned char color = 0;
+        int width = artGetWidth(art, 0, 0);
+        int height = artGetHeight(art, 0, 0);
+        unsigned char* data = artGetFrameData(art, 0, 0);
+        int localX = x - floorX;
+        int localY = y - floorY;
+        if (data != nullptr && localX >= 0 && localY >= 0 && localX < width && localY < height) {
+            color = data[localY * width + localX];
+        }
+        artUnlock(handle);
+
+        if (color != 0) {
+            return color;
+        }
+    }
+
+    return 0;
+}
