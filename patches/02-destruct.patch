+
+static void destructAddParticle(Particle&& particle)
+{
+    if (gParticles.size() >= kMaxParticles) {
+        return;
+    }
+    particle.tile = destructParticleTile(particle);
+    if (particle.tile == -1) {
+        return;
+    }
+    gParticles.push_back(std::move(particle));
+}
+
+static void destructLaunch(Particle* particle, float fromX, float fromY, float speed, float lift)
+{
+    float dx = particle->x - fromX;
+    float dy = (particle->y - fromY) * 2.0f;
+    float length = sqrtf(dx * dx + dy * dy);
+    if (length < 1.0f) {
+        float angle = destructBetween(0.0f, 6.2831853f);
+        dx = cosf(angle);
+        dy = sinf(angle);
+    } else {
+        dx /= length;
+        dy /= length;
+    }
+    particle->vx = dx * speed + destructBetween(-12.0f, 12.0f);
+    particle->vy = dy * speed * 0.5f + destructBetween(-6.0f, 6.0f);
+    particle->vz = lift;
+}
+
+// Cuts the art into pieces that fly away from the blast: splinters along the
+// grain for wood, crumbs for glass. Pieces of a roof fall from roof height
+// onto the floor under them.
+static void destructShatter(const DestructFrame& frame, int anchor, int elevation, float blastX, float blastY, float power, bool wall, DestructMaterial material, bool roof = false)
+{
+    int anchorX;
+    int anchorY;
+    if (!destructTileCenter(anchor, elevation, &anchorX, &anchorY)) {
+        return;
+    }
+
+    std::vector<int> opaque;
+    for (int index = 0; index < frame.width * frame.height; index++) {
+        if (frame.pixels[index] != 0) {
+            opaque.push_back(index);
+        }
+    }
+    if (opaque.empty()) {
+        return;
+    }
+
+    // Small pieces: nothing big and recognizable flies.
+    int area = material == DESTRUCT_GLASS ? 14 : (wall ? 60 : 45);
+    int cells = std::clamp((int)opaque.size() / area, 3, material == DESTRUCT_GLASS ? 200 : 120);
+    std::vector<std::pair<int, int>> seeds;
+    for (int index = 0; index < cells; index++) {
+        int pixel = opaque[destructPick((int)opaque.size())];
+        seeds.push_back({ pixel % frame.width, pixel / frame.width });
+    }
+
+    std::vector<int> labels(frame.width * frame.height, -1);
+    std::vector<Rect> bounds(cells, Rect { INT32_MAX, INT32_MAX, INT32_MIN, INT32_MIN });
+    std::vector<int> counts(cells, 0);
+    for (int pixel : opaque) {
+        int x = pixel % frame.width;
+        int y = pixel / frame.width;
+        int best = 0;
+        int bestDistance = INT32_MAX;
+        for (int cell = 0; cell < cells; cell++) {
+            int dx = x - seeds[cell].first;
+            int dy = y - seeds[cell].second;
+            // Rough edges, as broken things have; boards split along their
+            // grain, metal tears cleaner.
+            int rough = (int)(destructHash(x * 7 + cell, y * 13) & 31);
+            int distance;
+            if (material == DESTRUCT_WOOD) {
+                distance = dx * dx * 6 + dy * dy / 2 + rough * 3;
+            } else if (material == DESTRUCT_METAL) {
+                distance = dx * dx + dy * dy + rough;
+            } else {
+                distance = dx * dx + dy * dy + rough * 3;
+            }
+            if (distance < bestDistance) {
+                bestDistance = distance;
+                best = cell;
+            }
+        }
+        labels[pixel] = best;
+        Rect* rect = &(bounds[best]);
+        rect->left = std::min(rect->left, x);
+        rect->top = std::min(rect->top, y);
+        rect->right = std::max(rect->right, x);
+        rect->bottom = std::max(rect->bottom, y);
+        counts[best]++;
+    }
+
+    for (int cell = 0; cell < cells; cell++) {
+        if (counts[cell] == 0) {
+            continue;
+        }
+
+        const Rect& rect = bounds[cell];
+        // Bits of see-through art (fences, grates) read as specks of dirt
+        // once on the ground; the shards of their material stand in for them.
+        int boxArea = (rect.right - rect.left + 1) * (rect.bottom - rect.top + 1);
+        if (counts[cell] * 10 < boxArea * 3 && boxArea > 12) {
+            continue;
+        }
+
+        Particle piece = destructNewParticle(PARTICLE_PIECE, anchor, elevation);
+        piece.width = rect.right - rect.left + 1;
+        piece.height = rect.bottom - rect.top + 1;
+        piece.pixels.assign(piece.width * piece.height, 0);
+        for (int y = rect.top; y <= rect.bottom; y++) {
+            for (int x = rect.left; x <= rect.right; x++) {
+                int pixel = y * frame.width + x;
+                if (labels[pixel] == cell) {
+                    piece.pixels[(y - rect.top) * piece.width + (x - rect.left)] = frame.pixels[pixel];
+                }
+            }
+        }
+
+        int centerX = frame.left + rect.left + piece.width / 2;
+        int bottom = frame.top + rect.bottom;
+        int groundY = frame.groundY + (int)destructBetween(-3.0f, 3.0f);
+        piece.x = (float)(centerX - anchorX);
+        piece.material = material;
+        piece.variant = destructPick(8);
+        if (roof) {
+            piece.y = (float)(bottom + kRoofHeight - anchorY);
+            piece.z = (float)kRoofHeight;
+        } else if (bottom < groundY) {
+            piece.y = (float)(groundY - anchorY);
+            piece.z = (float)(groundY - bottom);
+        } else {
+            piece.y = (float)(bottom - anchorY);
+            piece.z = 0.0f;
+        }
+
+        float mass = sqrtf(std::max(1.0f, counts[cell] / 30.0f));
+        float speed = power * destructBetween(40.0f, 170.0f) / mass * (wall ? 0.7f : 1.0f);
+        float lift = power * destructBetween(30.0f, 190.0f) / mass + (piece.z > 30.0f ? 0.0f : 40.0f);
+        if (roof) {
+            // It loses its hold and drops, pushed a little by the blast.
+            speed *= 0.25f;
+            lift = destructBetween(0.0f, 50.0f);
+        }
+        destructLaunch(&piece, blastX, blastY, speed, lift);
+        if (std::max(piece.width, piece.height) <= 18 || material == DESTRUCT_GLASS) {
+            piece.spin = destructBetween(5.0f, 14.0f);
+            piece.frame = destructPick(4);
+        }
+        piece.keep = true;
+        destructAddParticle(std::move(piece));
+    }
+}
+
+static void destructSmoke(int anchor, int elevation, float x, float y, float z, unsigned char color, float opacity, float scale, float delay, float life)
+{
+    const DestructSprite* sprite = destructSpriteVariant("puff");
+    if (sprite == nullptr) {
+        return;
+    }
+
+    Particle smoke = destructNewParticle(PARTICLE_SMOKE, anchor, elevation);
+    smoke.sprite = sprite;
+    smoke.frame = destructPick(sprite->frames);
+    smoke.x = x;
+    smoke.y = y;
+    smoke.z = z;
+    smoke.vx = destructBetween(-8.0f, 14.0f);
+    smoke.vy = destructBetween(-4.0f, 4.0f);
+    smoke.vz = destructBetween(14.0f, 34.0f);
+    smoke.scale = scale;
+    smoke.growth = destructBetween(0.25f, 0.5f) * scale;
+    smoke.opacity = opacity;
+    smoke.color = color;
