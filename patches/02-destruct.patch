+void destructRenderTile(int tile, Rect* rect, int elevation)
+{
+    auto it = std::lower_bound(gParticleOrder.begin(), gParticleOrder.end(), std::make_pair(tile, -1));
+    if (it == gParticleOrder.end() || it->first != tile) {
+        return;
+    }
+
+    int light = destructLightAt(elevation, tile);
+    for (; it != gParticleOrder.end() && it->first == tile; ++it) {
+        destructDrawParticle(gParticles[it->second], rect, light);
+    }
+}
