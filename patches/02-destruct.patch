+static float destructRandom()
+{
+    gDestructSeed ^= gDestructSeed << 13;
+    gDestructSeed ^= gDestructSeed >> 17;
+    gDestructSeed ^= gDestructSeed << 5;
+    return (gDestructSeed >> 8) / 16777216.0f;
+}
+
+static float destructBetween(float min, float max)
+{
+    return min + (max - min) * destructRandom();
+}
+
+static int destructPick(int count)
+{
+    return std::min(count - 1, (int)(destructRandom() * count));
+}
