+static bool destructTileCenter(int tile, int elevation, int* x, int* y)
+{
+    if (tileToScreenXY(tile, x, y, elevation) != 0) {
+        return false;
+    }
+    *x += 16;
+    *y += 8;
+    return true;
+}
+
+static bool destructObjectFrame(Object* object, DestructFrame* frame)
+{
+    CacheEntry* handle;
+    Art* art = artLock(object->fid, &handle);
+    if (art == nullptr) {
+        return false;
+    }
+
+    int width = artGetWidth(art, object->frame, object->rotation);
+    int height = artGetHeight(art, object->frame, object->rotation);
+    unsigned char* data = artGetFrameData(art, object->frame, object->rotation);
+    int x;
+    int y;
+    if (data == nullptr || width <= 0 || height <= 0 || !destructTileCenter(object->tile, object->elevation, &x, &y)) {
+        artUnlock(handle);
+        return false;
+    }
+
+    frame->groundX = x;
+    frame->groundY = y;
+    x += art->xOffsets[object->rotation] + object->x;
+    y += art->yOffsets[object->rotation] + object->y;
+    frame->left = x - width / 2;
+    frame->top = y - (height - 1);
+    frame->width = width;
+    frame->height = height;
+    frame->pixels.assign(data, data + width * height);
+    artUnlock(handle);
+    return true;
+}
