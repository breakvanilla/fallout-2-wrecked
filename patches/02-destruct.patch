+static const DestructSprite* destructSprite(const std::string& name)
+{
+    auto it = gDestructSprites.find(name);
+    return it != gDestructSprites.end() ? &(it->second) : nullptr;
+}
+
+// One of `prefix`0, `prefix`1, ... at random.
+static const DestructSprite* destructSpriteVariant(const char* prefix, std::string* name = nullptr)
+{
+    int count = 0;
+    while (gDestructSprites.find(prefix + std::to_string(count)) != gDestructSprites.end()) {
+        count++;
+    }
+
+    if (count == 0) {
+        return nullptr;
+    }
+
+    std::string chosen = prefix + std::to_string(destructPick(count));
+    if (name != nullptr) {
+        *name = chosen;
+    }
+    return destructSprite(chosen);
+}
