+// The meteor over everything: a burning head with a tail of fire, and the
+// ground lit orange under it as it nears.
+static void destructRenderMeteor(Rect* rect)
+{
+    Rect meteorRect;
+    Rect clipped;
+    if (!destructMeteorRect(&meteorRect) || !destructClip(&meteorRect, rect, &clipped)) {
+        return;
+    }
+
+    int targetX;
+    int targetY;
+    destructMeteorTarget(&targetX, &targetY);
+    float progress = destructMeteorProgress();
+    float x;
+    float y;
+    float z;
+    destructMeteorPosition(progress, &x, &y, &z);
+    float headX = targetX + x;
+    float headY = targetY + y - z;
+
+    // The ground glows under it.
+    float glow = 18.0f + 46.0f * progress;
+    for (int py = std::max(clipped.top, targetY - (int)(glow * 0.5f) - 1); py <= std::min(clipped.bottom, targetY + (int)(glow * 0.5f) + 1); py++) {
+        for (int px = std::max(clipped.left, targetX - (int)glow - 1); px <= std::min(clipped.right, targetX + (int)glow + 1); px++) {
+            float dx = (px - targetX) / glow;
+            float dy = (py - targetY) * 2.0f / glow;
+            float d = dx * dx + dy * dy;
+            if (d < 1.0f) {
+                destructBlend(gDestructBuffer + py * gDestructPitch + px, 255, 150, 60, (int)(150.0f * progress * (1.0f - d)));
+            }
+        }
+    }
+
+    // The tail: back along the way it came, thinning and cooling.
+    float pathX = kMeteorFromX;
+    float pathY = kMeteorFromY - kMeteorHeight;
+    float length = sqrtf(pathX * pathX + pathY * pathY);
+    float dirX = pathX / length;
+    float dirY = pathY / length;
+    float tail = 40.0f + 110.0f * progress;
+    float head = 4.0f + 6.0f * progress;
+    for (int py = clipped.top; py <= clipped.bottom; py++) {
+        for (int px = clipped.left; px <= clipped.right; px++) {
+            float rx = px + 0.5f - headX;
+            float ry = py + 0.5f - headY;
+            float along = rx * dirX + ry * dirY;
+            float across = fabsf(-rx * dirY + ry * dirX);
+            float d = sqrtf(rx * rx + ry * ry);
+            if (d < head) {
+                // White-hot core, yellow rim.
+                float k = d / head;
+                destructBlend(gDestructBuffer + py * gDestructPitch + px, 255, (int)(255 - 50 * k), (int)(230 - 170 * k), 255);
+                continue;
+            }
+            if (d < head * 2.6f) {
+                float k = (d - head) / (head * 1.6f);
+                destructBlend(gDestructBuffer + py * gDestructPitch + px, 255, 170, 70, (int)(170.0f * (1.0f - k)));
+                continue;
+            }
+            if (along <= 0.0f || along > tail) {
+                continue;
+            }
+            float t = along / tail;
+            float width = head * (1.0f - 0.85f * t) * (0.85f + 0.3f * sinf(along * 0.4f - gMeteor.age * 40.0f));
+            if (across > width) {
+                continue;
+            }
+            float edge = across / std::max(0.5f, width);
+            int r = 255;
+            int g = (int)(220 - 170 * t);
+            int b = (int)(120 - 100 * t);
+            int alpha = (int)(240.0f * (1.0f - t) * (1.0f - 0.6f * edge));
+            destructBlend(gDestructBuffer + py * gDestructPitch + px, r, std::max(g, 30), std::max(b, 10), alpha);
+        }
+    }
+}
