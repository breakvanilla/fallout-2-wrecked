+static void destructLoadSprites()
+{
+    gDestructSprites.clear();
+
+    FILE* stream = fopen("wrecked-fallout-2/sprites.dat", "rb");
+    if (stream == nullptr) {
+        return;
+    }
+
+    char magic[4];
+    uint32_t count;
+    if (fread(magic, 1, 4, stream) != 4 || memcmp(magic, "DST1", 4) != 0 || fread(&count, 4, 1, stream) != 1) {
+        fclose(stream);
+        return;
+    }
+
+    for (uint32_t index = 0; index < count; index++) {
+        char name[16];
+        uint16_t header[4];
+        int16_t anchor[2];
+        if (fread(name, 1, 16, stream) != 16 || fread(header, 2, 4, stream) != 4 || fread(anchor, 2, 2, stream) != 2) {
+            break;
+        }
+
+        DestructSprite sprite;
+        sprite.frames = header[0];
+        sprite.width = header[1];
+        sprite.height = header[2];
+        sprite.channels = header[3];
+        sprite.anchorX = anchor[0];
+        sprite.anchorY = anchor[1];
+        if (sprite.frames < 1 || sprite.frames > 64 || sprite.width < 1 || sprite.width > 1024 || sprite.height < 1 || sprite.height > 1024 || sprite.channels < 1 || sprite.channels > 3) {
+            break;
+        }
+        size_t size = (size_t)sprite.frames * sprite.width * sprite.height * sprite.channels;
+        sprite.data.resize(size);
+        if (fread(sprite.data.data(), 1, size, stream) != size) {
+            break;
+        }
+
+        if (sprite.frames < 1 || (sprite.channels != 2 && sprite.channels != 3)) {
+            continue;
+        }
+
+        name[15] = '\0';
+        gDestructSprites[name] = std::move(sprite);
+    }
+
+    fclose(stream);
+}
