+static void destructSettle(Particle* particle)
+{
+    particle->dead = true;
+    if (!particle->keep || (particle->kind != PARTICLE_PIECE && particle->kind != PARTICLE_CHUNK) || particle->tile == -1) {
+        return;
+    }
+
+    Rect rect;
+    int tileX;
+    int tileY;
+    if (!destructParticleRect(*particle, &rect) || tileToScreenXY(particle->tile, &tileX, &tileY, particle->elevation) != 0) {
+        return;
+    }
+
+    Decal debris;
+    debris.kind = DECAL_PIXELS;
+    debris.elevation = particle->elevation;
+    debris.tile = particle->tile;
+    debris.x = rect.left - tileX;
+    debris.y = rect.top - tileY;
+    debris.frame = 0;
+    memset(debris.colors, 0, sizeof(debris.colors));
+    debris.width = rect.right - rect.left + 1;
+    debris.height = rect.bottom - rect.top + 1;
+    debris.resolved = nullptr;
+    if (particle->kind == PARTICLE_PIECE) {
+        // Lying down it shows half its height, in the shade of the ground.
+        int width;
+        int height;
+        destructPieceSize(*particle, &width, &height);
+        int flat = std::max(1, (height + 1) / 2);
+        debris.y += height - flat;
+        debris.width = width;
+        debris.height = flat;
+        debris.pixels.assign((size_t)width * flat, 0);
+        for (int y = 0; y < flat; y++) {
+            for (int x = 0; x < width; x++) {
+                unsigned char color = destructPiecePixel(*particle, x, std::min(height - 1, y * 2 + 1));
+                if (color == 0) {
+                    color = destructPiecePixel(*particle, x, y * 2);
+                }
+                if (color != 0 && color < kGlowStart) {
+                    // Glass on the ground still catches the light here and
+                    // there.
+                    int level = particle->material == DESTRUCT_GLASS && (destructHash(x + particle->variant, y) & 3) == 0 ? 190 : 108;
+                    color = intensityColorTable[color][level];
+                    if (color == 0) {
+                        color = gDestructDark;
+                    }
+                }
+                debris.pixels[(size_t)y * width + x] = color;
+            }
+        }
+    } else {
+        const DestructSprite* sprite = particle->sprite;
+        int frame = particle->frame % sprite->frames;
+        debris.pixels.assign(debris.width * debris.height, 0);
+        for (int y = 0; y < sprite->height; y++) {
+            for (int x = 0; x < sprite->width; x++) {
+                const unsigned char* pixel = sprite->pixel(frame, x, y);
+                if (pixel[sprite->channels - 1] >= 128) {
+                    unsigned char color = intensityColorTable[particle->color][pixel[0]];
+                    debris.pixels[y * debris.width + x] = color != 0 ? color : 1;
+                }
+            }
+        }
+    }
+    destructAddDecal(std::move(debris));
+}
+
+static void destructStep(Particle* particle, float dt)
+{
+    if (particle->delay > 0.0f) {
+        particle->delay -= dt;
+        return;
+    }
+
+    particle->age += dt;
+
+    switch (particle->kind) {
+    case PARTICLE_PIECE:
+    case PARTICLE_CHUNK: {
+        float oldX = particle->x;
+        float oldY = particle->y;
+        if (particle->material == DESTRUCT_CLOTH) {
+            // Rags flutter down slowly, swaying.
+            float drag = std::max(0.0f, 1.0f - 2.2f * dt);
+            particle->vx *= drag;
+            particle->vy *= drag;
+            particle->vz = std::max(particle->vz - kGravity * 0.35f * dt, -55.0f);
+            particle->x += sinf(particle->age * 6.0f + particle->variant) * 22.0f * dt;
+        } else {
+            particle->vz -= kGravity * dt;
+        }
+        particle->x += particle->vx * dt;
+        particle->y += particle->vy * dt;
+        particle->z += particle->vz * dt;
+        if (particle->kind == PARTICLE_CHUNK && particle->spin > 0.0f) {
+            particle->frame = particle->sprite->frames > 0 ? (int)(particle->age * particle->spin) % particle->sprite->frames : 0;
+        }
+        if (particle->kind == PARTICLE_PIECE && particle->spin > 0.0f && particle->z > 0.0f) {
+            particle->frame = (int)(particle->age * particle->spin) % 4;
+        }
+
+        if (particle->z <= 0.0f) {
+            particle->z = 0.0f;
+            // Metal rings and bounces, glass skitters, cloth just lands.
+            float bounce = particle->material == DESTRUCT_METAL ? 0.45f : (particle->material == DESTRUCT_GLASS ? 0.2f : 0.3f);
+            float keepSpeed = particle->material == DESTRUCT_GLASS ? 0.75f : 0.55f;
+            if (particle->vz < (particle->material == DESTRUCT_METAL ? -45.0f : -70.0f) && particle->material != DESTRUCT_CLOTH) {
+                particle->vz = -particle->vz * bounce;
+                particle->vx *= keepSpeed;
+                particle->vy *= keepSpeed;
+            } else {
+                particle->vz = 0.0f;
+                float friction = std::max(0.0f, 1.0f - 9.0f * dt);
+                particle->vx *= friction;
+                particle->vy *= friction;
+                particle->spin *= friction;
+                if (fabsf(particle->vx) + fabsf(particle->vy) < 6.0f) {
+                    destructSettle(particle);
+                    return;
+                }
+            }
+        }
+
+        int tile = destructParticleTile(*particle);
+        if (tile == -1) {
+            particle->dead = true;
+            return;
+        }
+
+        if (tile != particle->tile) {
+            Object* blocker = _obj_blocking_at(nullptr, tile, particle->elevation);
+            if (blocker != nullptr && particle->z < 48.0f) {
+                // Bounces off what stands there.
+                particle->x = oldX;
+                particle->y = oldY;
+                particle->vx *= -0.35f;
+                particle->vy *= -0.35f;
+            } else {
+                particle->tile = tile;
+            }
+        }
+
+        if (particle->age > 7.0f) {
+            particle->z = 0.0f;
+            destructSettle(particle);
+        }
+        break;
+    }
+    case PARTICLE_SPARK:
+        particle->vz -= kGravity * 0.8f * dt;
+        particle->x += particle->vx * dt;
+        particle->y += particle->vy * dt;
+        particle->z += particle->vz * dt;
+        if (particle->z <= 0.0f || particle->age >= particle->life) {
+            particle->dead = true;
+            return;
+        }
+        particle->tile = destructParticleTile(*particle);
+        if (particle->tile == -1) {
+            particle->dead = true;
+        }
+        break;
+    case PARTICLE_FIRE: {
+        float drag = std::max(0.0f, 1.0f - 2.6f * dt);
+        particle->vx *= drag;
+        particle->vy *= drag;
+        particle->vz = particle->vz * std::max(0.0f, 1.0f - 2.0f * dt) + 24.0f * dt;
+        particle->x += particle->vx * dt;
+        particle->y += particle->vy * dt;
+        particle->z += particle->vz * dt;
+        particle->scale += particle->growth * dt;
+        if (particle->age >= particle->life) {
+            // Burnt out into smoke.
+            particle->kind = PARTICLE_SMOKE;
+            particle->age = 0.0f;
+            particle->life = destructBetween(1.8f, 3.2f);
+            particle->opacity = 0.5f;
+            particle->vz = destructBetween(16.0f, 32.0f);
+            particle->growth = destructBetween(0.15f, 0.35f);
+        }
+        particle->tile = destructParticleTile(*particle);
+        if (particle->tile == -1) {
+            particle->dead = true;
+        }
+        break;
+    }
+    case PARTICLE_SMOKE: {
+        float drag = std::max(0.0f, 1.0f - 1.6f * dt);
+        particle->vx *= drag;
+        particle->vy *= drag;
+        particle->x += particle->vx * dt;
+        particle->y += particle->vy * dt;
+        particle->z += particle->vz * dt;
+        particle->scale += particle->growth * dt;
+        if (particle->age >= particle->life) {
+            particle->dead = true;
+            return;
+        }
+        particle->tile = destructParticleTile(*particle);
+        if (particle->tile == -1) {
+            particle->dead = true;
+        }
+        break;
+    }
+    }
+}
+
+static void destructTick()
+{
+    if (!gDestructInitialized) {
+        return;
+    }
+
+    unsigned int now = SDL_GetTicks();
+    float dt = std::min(0.1f, (now - gDestructLastTick) / 1000.0f);
+    gDestructLastTick = now;
+    // Paused with the map, as the game's own animations are: under the
+    // inventory, the Pip-Boy, dialog and the world map.
+    if (isoIsDisabled()) {
+        return;
+    }
+    if (gParticles.empty() && !gFlashDirty && !gBeam.active && !gMeteor.active) {
+        return;
+    }
+    if (dt <= 0.0f) {
+        return;
+    }
+
+    Rect dirty;
+    bool anyDirty = false;
+    auto addDirty = [&](const Rect& rect) {
+        if (anyDirty) {
+            rectUnion(&dirty, &rect, &dirty);
+        } else {
+            dirty = rect;
+            anyDirty = true;
+        }
+    };
+
+    for (Particle& particle : gParticles) {
+        if (particle.hasDrawn && particle.elevation == gElevation) {
+            addDirty(particle.drawn);
+        }
+
+        destructStep(&particle, dt);
+
+        Rect rect;
+        if (!particle.dead && particle.delay <= 0.0f && destructParticleRect(particle, &rect)) {
+            particle.drawn = rect;
+            particle.hasDrawn = true;
+            if (particle.elevation == gElevation) {
+                addDirty(rect);
+            }
+        }
+    }
+
+    gParticles.erase(std::remove_if(gParticles.begin(), gParticles.end(), [](const Particle& particle) {
+        return particle.dead;
+    }),
+        gParticles.end());
+
+    if (gBeam.active) {
+        destructBeamStep(dt, &dirty, &anyDirty);
+    }
+    if (gMeteor.active) {
+        destructMeteorStep(dt, &dirty, &anyDirty);
+    }
+
+    if (gFlashDirty) {
+        Rect rect;
+        if (gFlashElevation == gElevation && destructFlashRect(&rect)) {
+            addDirty(rect);
+        }
+        gFlashAge += dt;
+        if (gFlashAge >= kFlashTime) {
+            gFlashDirty = false;
+        }
+    }
+
+    if (anyDirty) {
+        tileWindowRefreshRect(&dirty, gElevation);
+    }
+}
+
