+static uint64_t destructDamageKey(int elevation, int tile, int fid)
+{
+    return ((uint64_t)(uint32_t)fid << 32) | ((uint64_t)elevation << 24) | (uint32_t)tile;
+}
+
+static std::vector<Damage>* destructCurrentDamage()
+{
+    auto it = gDestructDamage.find(gDestructMap);
+    return it != gDestructDamage.end() && !it->second.empty() ? &(it->second) : nullptr;
+}
+
+static void destructIndexDamage()
+{
+    if (!gDamageIndexDirty) {
+        return;
+    }
+    gDamageIndex.clear();
+    std::vector<Damage>* list = destructCurrentDamage();
+    if (list != nullptr) {
+        for (size_t index = 0; index < list->size(); index++) {
+            const Damage& damage = (*list)[index];
+            gDamageIndex[destructDamageKey(damage.elevation, damage.tile, damage.fid)] = index;
+        }
+    }
+    gDamageIndexDirty = false;
+}
+
+static Damage* destructFindDamage(Object* object)
+{
+    if (destructCurrentDamage() == nullptr) {
+        return nullptr;
+    }
+    destructIndexDamage();
+    auto it = gDamageIndex.find(destructDamageKey(object->elevation, object->tile, object->fid));
+    return it != gDamageIndex.end() ? &((*destructCurrentDamage())[it->second]) : nullptr;
+}
+
+static void destructForgetDamage(Object* object)
+{
+    std::vector<Damage>* list = destructCurrentDamage();
+    if (list == nullptr) {
+        return;
+    }
+    list->erase(std::remove_if(list->begin(), list->end(), [object](const Damage& damage) {
+        return damage.elevation == object->elevation && damage.tile == object->tile && damage.fid == object->fid;
+    }),
+        list->end());
+    gDamageIndexDirty = true;
+}
+
+const unsigned char* destructDamagedFrame(Object* object, const unsigned char* data, int width, int height)
+{
+    if (!gDestructInitialized || data == nullptr) {
+        return nullptr;
+    }
+
+    Damage* damage = destructFindDamage(object);
+    if (damage == nullptr || damage->width != width || damage->height != height) {
+        return nullptr;
+    }
+
+    if (damage->frame != object->frame || damage->rotation != object->rotation || damage->pixels.empty()) {
+        damage->pixels.resize((size_t)width * height);
+        for (size_t index = 0; index < damage->pixels.size(); index++) {
+            unsigned char color = data[index];
+            unsigned char mark = damage->mask[index];
+            if (color == 0 || mark == kGone) {
+                color = 0;
+            } else if (mark != 0 && color < kGlowStart) {
+                color = intensityColorTable[color][mark];
+                if (color == 0) {
+                    color = gDestructDark;
+                }
+            }
+            damage->pixels[index] = color;
+        }
+        damage->frame = object->frame;
+        damage->rotation = object->rotation;
+    }
+
+    return damage->pixels.data();
+}
+
+// Smooth noise in 0..1 with features about `size` pixels across.
+static float destructNoise(float x, float y, float size, int seed)
+{
+    x /= size;
+    y /= size;
+    int left = (int)floorf(x);
+    int top = (int)floorf(y);
+    float fx = x - left;
+    float fy = y - top;
+    fx = fx * fx * (3 - 2 * fx);
+    fy = fy * fy * (3 - 2 * fy);
+    auto value = [seed](int cx, int cy) {
+        return (destructHash(cx * 31 + seed, cy * 17 - seed) & 0xFFFF) / 65535.0f;
+    };
+    float a = value(left, top) + (value(left + 1, top) - value(left, top)) * fx;
+    float b = value(left, top + 1) + (value(left + 1, top + 1) - value(left, top + 1)) * fx;
+    return a + (b - a) * fy;
+}
+
+// Marks in `reached` what hangs together, 8 ways, with what `reached`
+// already marks, over the pixels `alive` marks.
+static void destructFlood(const std::vector<unsigned char>& alive, int width, int height, std::vector<unsigned char>& reached)
+{
+    std::vector<int> stack;
+    for (int index = 0; index < width * height; index++) {
+        if (reached[index] != 0) {
+            stack.push_back(index);
+        }
+    }
+    while (!stack.empty()) {
+        int index = stack.back();
+        stack.pop_back();
+        int x = index % width;
+        int y = index / width;
+        for (int dy = -1; dy <= 1; dy++) {
+            for (int dx = -1; dx <= 1; dx++) {
+                int nx = x + dx;
+                int ny = y + dy;
+                if (nx < 0 || ny < 0 || nx >= width || ny >= height) {
+                    continue;
+                }
+                int next = ny * width + nx;
+                if (alive[next] != 0 && reached[next] == 0) {
+                    reached[next] = 1;
+                    stack.push_back(next);
+                }
+            }
+        }
+    }
+}
+
+#ifdef WRECKED_TEST
+static float gDebugNearest = 0.0f;
+#endif
+
+// Takes a ragged bite out of the object around `blastX`, `blastY` (screen),
+// soots what is left near it and lights the bite's edges. `collapse` also
+// brings down what stands above a ragged line near the foot, as wide as the
+// bite, so that a hole runs across wall pieces without seams. `removed` gets
+// the art that came off; returns the share of the art still standing.
+static float destructDamageObject(Object* object, const DestructFrame& frame, float blastX, float blastY, float radius, bool remove, bool collapse, DestructMaterial material, DestructFrame* removed)
+{
+#ifdef WRECKED_TEST
+    gDebugNearest = 1e9f;
+#endif
+    bool wall = FID_TYPE(object->fid) == OBJ_TYPE_WALL || frame.height > 56;
+    Damage* damage = destructFindDamage(object);
+    if (damage == nullptr || damage->width != frame.width || damage->height != frame.height) {
+        if (damage != nullptr) {
+            destructForgetDamage(object);
+        }
+        std::vector<Damage>& list = gDestructDamage[gDestructMap];
+        Damage fresh;
+        fresh.elevation = object->elevation;
+        fresh.tile = object->tile;
+        fresh.fid = object->fid;
+        fresh.width = frame.width;
+        fresh.height = frame.height;
+        fresh.mask.assign((size_t)frame.width * frame.height, 0);
+        fresh.frame = -1;
+        fresh.rotation = -1;
+        list.push_back(std::move(fresh));
+        gDamageIndexDirty = true;
+        damage = &(list.back());
+    }
+
+    int seed = object->tile * 7 + object->fid;
+    int width = frame.width;
+    int height = frame.height;
+    std::vector<unsigned char>& mask = damage->mask;
+
+    *removed = frame;
+    std::fill(removed->pixels.begin(), removed->pixels.end(), 0);
+
+    // The foot of each column, for a collapse.
+    std::vector<int> foot(width, -1);
+    if (wall) {
+        for (int x = 0; x < width; x++) {
+            for (int y = height - 1; y >= 0; y--) {
+                if (frame.pixels[y * width + x] != 0) {
+                    foot[x] = y;
+                    break;
+                }
+            }
+        }
+    }
+
+    std::vector<float> reach((size_t)width * height, 0.0f);
+    int total = 0;
+    int standing = 0;
+    for (int y = 0; y < height; y++) {
+        for (int x = 0; x < width; x++) {
+            size_t index = (size_t)y * width + x;
+            if (frame.pixels[index] == 0) {
+                continue;
+            }
+            total++;
+            if (mask[index] == kGone) {
+                continue;
+            }
+
+            float screenX = (float)(frame.left + x);
+            float screenY = (float)(frame.top + y);
+            float dx = (screenX - blastX) / (radius * 1.25f);
+            float dy = (screenY - blastY) / radius;
+            float rough = 0.6f * destructNoise(screenX, screenY, 7.0f, 21) + 0.4f * destructNoise(screenX, screenY, 1.8f, 22);
+            // Distance from the blast in units of the bite's ragged edge.
+            float distance = sqrtf(dx * dx + dy * dy) / (0.72f + 0.56f * rough);
+            reach[index] = distance;
+#ifdef WRECKED_TEST
+            gDebugNearest = std::min(gDebugNearest, distance);
+#endif
+
+            bool gone = remove && distance < 1.0f;
+            // Masonry keeps a ragged foot; boards, sheets and cloth come
+            // down whole.
+            bool footed = material == DESTRUCT_STONE;
+            if (gone && footed && foot[x] != -1 && y >= foot[x] - 3 - (int)(5.0f * destructNoise(screenX, 0.0f, 6.0f, 15) + 3.0f * destructNoise(screenX, 0.0f, 1.5f, 16))) {
+                gone = false;
+            }
+            if (collapse && foot[x] != -1) {
+                // The noise follows the screen, not the piece, so that
+                // neighbouring pieces break along one line.
+                float side = fabsf(screenX - blastX) / (radius * 1.25f * (0.7f + 0.5f * destructNoise(0.0f, screenY, 6.0f, 11) + 0.3f * destructNoise(0.0f, screenY, 1.5f, 12)));
+                float keep = 7.0f + 16.0f * destructNoise(screenX, 0.0f, 9.0f, 13) + 3.0f * destructNoise(screenX, 0.0f, 2.0f, 14);
+                gone = gone || (side < 1.0f && (!footed || y < foot[x] - (int)keep));
+            }
+
+            if (gone) {
+                mask[index] = kGone;
+                removed->pixels[index] = frame.pixels[index];
+            } else {
+                standing++;
+            }
+        }
+    }
+
+    // What no longer hangs together with the foot of the art falls too: a
+    // bite can leave the top of a wall in the air. Bits that don't touch the
+    // foot in the whole art either stay.
+    if (remove || collapse) {
+        std::vector<int> bottom(width, -1);
+        for (int x = 0; x < width; x++) {
+            for (int y = height - 1; y >= 0; y--) {
+                if (frame.pixels[y * width + x] != 0) {
+                    bottom[x] = y;
+                    break;
+                }
+            }
+        }
+        size_t size = (size_t)width * height;
+        std::vector<unsigned char> whole(size);
+        std::vector<unsigned char> alive(size);
+        std::vector<unsigned char> held(size, 0);
+        std::vector<unsigned char> heldWhole(size, 0);
+        for (size_t index = 0; index < size; index++) {
+            int x = (int)(index % width);
+            int y = (int)(index / width);
+            whole[index] = frame.pixels[index] != 0;
+            alive[index] = whole[index] && mask[index] != kGone;
+            bool foot = bottom[x] != -1 && y >= bottom[x] - 4;
+            heldWhole[index] = whole[index] && foot;
+            held[index] = alive[index] && foot;
+        }
+        destructFlood(whole, width, height, heldWhole);
+        destructFlood(alive, width, height, held);
+        for (size_t index = 0; index < size; index++) {
+            if (alive[index] && !held[index] && heldWhole[index]) {
+                mask[index] = kGone;
+                removed->pixels[index] = frame.pixels[index];
+                standing--;
+            }
+        }
+    }
+
+    auto isGone = [&](int x, int y) {
+        if (x < 0 || y < 0 || x >= width || y >= height) {
+            return false;
+        }
+        size_t index = (size_t)y * width + x;
+        return frame.pixels[index] != 0 && mask[index] == kGone;
+    };
+
+    for (int y = 0; y < height; y++) {
+        for (int x = 0; x < width; x++) {
+            size_t index = (size_t)y * width + x;
+            if (frame.pixels[index] == 0 || mask[index] == kGone) {
+                continue;
+            }
+
+            int level = mask[index] != 0 ? mask[index] : 128;
+
+            // Soot, heaviest close to the blast.
+            float distance = reach[index];
+            if (distance < 2.4f) {
+                float soot = std::clamp((2.4f - distance) / 1.3f, 0.0f, 1.0f);
+                float patchy = 0.55f + 0.45f * destructNoise((float)(frame.left + x), (float)(frame.top + y), 4.0f, seed + 4);
+                level = std::min(level, 128 - (int)(88.0f * soot * patchy));
+            }
+
+            // Broken edges: what faces up catches the light, the rest is in
+            // shadow, which makes the wall look as thick as it is.
+            if (isGone(x, y - 1)) {
+                level = 176;
+            } else if (isGone(x, y - 2)) {
+                level = 150;
+            } else if (isGone(x - 1, y) || isGone(x + 1, y) || isGone(x, y + 1)) {
+                level = std::min(level, 58);
+            } else if (isGone(x - 2, y) || isGone(x + 2, y) || isGone(x, y + 2)) {
+                level = std::min(level, 88);
+            }
+
+            mask[index] = level == 128 ? 0 : (unsigned char)std::clamp(level, 1, 254);
+        }
+    }
+
+    damage->frame = -1;
+    return total > 0 ? (float)standing / total : 0.0f;
+}
+
+static void destructDust(int tile, int elevation, const DestructFrame& frame, int blastX, int blastY, const unsigned char* colors, int count)
+{
+    int dustR = 0;
+    int dustG = 0;
+    int dustB = 0;
+    for (int index = 0; index < 8; index++) {
+        int r;
+        int g;
+        int b;
+        destructColorRgb(colors[index], &r, &g, &b);
+        dustR += r;
+        dustG += g;
+        dustB += b;
+    }
+    unsigned char dust = destructNearest(dustR / 8 + 20, dustG / 8 + 18, dustB / 8 + 14);
+    for (int index = 0; index < count; index++) {
+        destructSmoke(tile, elevation,
+            (float)(frame.groundX - blastX) + destructBetween(-14.0f, 14.0f),
+            (float)(frame.groundY - blastY) + destructBetween(-4.0f, 4.0f),
+            destructBetween(4.0f, frame.height * 0.5f),
+            dust, 0.6f, destructBetween(0.45f, 0.8f), destructBetween(0.05f, 0.4f), destructBetween(1.6f, 2.8f));
+    }
+}
+
+// Chunks of what broke, in its colors: stones, boards, bent sheets of metal
+// or rags; glass flies apart in glints. `frame` is the art that came off,
+// `anchor` the blast's tile. Metal throws sparks.
+static void destructMaterialDebris(const DestructFrame& frame, int anchor, int elevation, float power, const unsigned char* colors, DestructMaterial material)
+{
+    int anchorX;
+    int anchorY;
+    if (!destructTileCenter(anchor, elevation, &anchorX, &anchorY)) {
+        return;
+    }
+
+    std::vector<int> opaque;
+    for (int index = 0; index < frame.width * frame.height; index++) {
+        if (frame.pixels[index] != 0) {
+            opaque.push_back(index);
+        }
+    }
+    if (opaque.empty()) {
+        return;
+    }
+
+    float amount = gDestructConfig.debris / 100.0f;
+    const char* kinds[] = { "rock", "plank", "shard", "", "scrap" };
+    int count = material == DESTRUCT_GLASS
+        ? std::clamp((int)opaque.size() / 25, 6, 40)
+        : std::clamp((int)opaque.size() / 120, 2, 14);
+    count = (int)(count * amount);
+
+    for (int index = 0; index < count; index++) {
+        int pixel = opaque[destructPick((int)opaque.size())];
+        int x = frame.left + pixel % frame.width;
+        int y = frame.top + pixel / frame.width;
+        unsigned char color = colors[2 + destructPick(5)];
+
+        Particle chunk = destructNewParticle(PARTICLE_CHUNK, anchor, elevation);
+        if (material == DESTRUCT_GLASS) {
+            chunk.kind = PARTICLE_PIECE;
+            chunk.width = 1 + destructPick(2);
+            chunk.height = 1;
+            chunk.pixels.assign(chunk.width, frame.pixels[pixel] < kGlowStart ? frame.pixels[pixel] : color);
+            chunk.spin = destructBetween(6.0f, 14.0f);
+        } else {
+            const DestructSprite* sprite = destructSpriteVariant(kinds[material]);
+            if (sprite == nullptr) {
+                return;
+            }
+            chunk.sprite = sprite;
+            chunk.color = color;
+            chunk.frame = destructPick(sprite->frames);
+            chunk.spin = material == DESTRUCT_CLOTH ? destructBetween(3.0f, 7.0f) : destructBetween(8.0f, 20.0f);
+        }
+        chunk.material = material;
+        chunk.variant = destructPick(8);
+        chunk.x = (float)(x - anchorX);
+        chunk.y = (float)(frame.groundY - anchorY) + destructBetween(-3.0f, 3.0f);
+        chunk.z = (float)std::max(0, frame.groundY - y);
+        destructLaunch(&chunk, 0.0f, 0.0f, destructBetween(40.0f, 180.0f) * power, destructBetween(60.0f, 260.0f) * power);
+        chunk.keep = true;
+        destructAddParticle(std::move(chunk));
+    }
+
+    if (material == DESTRUCT_METAL) {
+        int sparks = (int)((6 + 8 * power) * amount);
+        for (int index = 0; index < sparks; index++) {
+            int pixel = opaque[destructPick((int)opaque.size())];
+            Particle spark = destructNewParticle(PARTICLE_SPARK, anchor, elevation);
+            spark.variant = destructPick(5);
+            spark.x = (float)(frame.left + pixel % frame.width - anchorX);
+            spark.y = (float)(frame.groundY - anchorY);
+            spark.z = (float)std::max(2, frame.groundY - (frame.top + pixel / frame.width));
+            float angle = destructBetween(0.0f, 6.2831853f);
+            float speed = destructBetween(60.0f, 220.0f);
+            spark.vx = cosf(angle) * speed;
+            spark.vy = sinf(angle) * speed * 0.5f;
+            spark.vz = destructBetween(40.0f, 220.0f);
+            spark.life = destructBetween(0.25f, 0.7f);
+            destructAddParticle(std::move(spark));
+        }
+    }
+}
+
+// Puffs of dust for what broke: stone and earth crumble into a lot of it.
+static int destructDustCount(DestructMaterial material, int stone)
+{
+    switch (material) {
+    case DESTRUCT_STONE:
+        return stone;
+    case DESTRUCT_WOOD:
+    case DESTRUCT_CLOTH:
+        return std::max(1, stone / 2);
+    default:
+        return 0;
+    }
+}
+
+static bool destructMapBlocked()
+{
+    return std::find(gDestructConfig.blockedMaps.begin(), gDestructConfig.blockedMaps.end(), gDestructMap) != gDestructConfig.blockedMaps.end();
+}
+
+static RoofDamage* destructFindRoof(int elevation, int square)
+{
+    auto map = gDestructRoofs.find(gDestructMap);
+    if (map == gDestructRoofs.end()) {
+        return nullptr;
+    }
+    auto it = map->second.find(elevation * SQUARE_GRID_SIZE + square);
+    return it != map->second.end() ? &(it->second) : nullptr;
+}
+
+const unsigned char* destructDamagedRoof(int elevation, int square, int fid, const unsigned char* data, int width, int height)
+{
+    if (!gDestructInitialized || data == nullptr || gDestructRoofs.empty()) {
+        return nullptr;
+    }
+
+    RoofDamage* damage = destructFindRoof(elevation, square);
+    if (damage == nullptr || damage->fid != fid || damage->width != width || damage->height != height) {
+        return nullptr;
+    }
+
+    if (damage->pixels.empty()) {
+        damage->pixels.resize((size_t)width * height);
+        for (size_t index = 0; index < damage->pixels.size(); index++) {
+            unsigned char color = data[index];
+            unsigned char mark = damage->mask[index];
+            if (color == 0 || mark == kGone) {
+                color = 0;
+            } else if (mark != 0 && color < kGlowStart) {
+                color = intensityColorTable[color][mark];
+                if (color == 0) {
+                    color = gDestructDark;
+                }
+            }
+            damage->pixels[index] = color;
+        }
+    }
+
+    return damage->pixels.data();
+}
+
+// Brings down the roof around the blast (a wall gave way, the beam, a
+// meteor): a ragged hole `radius` screen pixels across the ground, with
+// sooted, broken edges, only where there is a floor under it to show. Roof
+// the hole cuts off from the rest comes down too, all of it in pieces.
+static void destructBreakRoof(int tile, int elevation, int blastX, int blastY, float radius, float power, Rect* dirty, bool* anyDirty)
+{
+    Rect area;
+    area.left = blastX - (int)(radius * 2.0f);
+    area.right = blastX + (int)(radius * 2.0f);
+    area.top = blastY - kRoofHeight - (int)radius;
+    area.bottom = blastY - kRoofHeight + (int)radius;
+
+    // Roof that touches the edge of this region is held by the rest.
+    const int margin = 48;
+    Rect region = { area.left - margin, area.top - margin, area.right + margin, area.bottom + margin };
+    int regionWidth = region.right - region.left + 1;
+    int regionHeight = region.bottom - region.top + 1;
+
+    int corners[4][2] = { { region.left, region.top }, { region.right, region.top }, { region.left, region.bottom }, { region.right, region.bottom } };
+    int minX = INT32_MAX;
+    int minY = INT32_MAX;
+    int maxX = INT32_MIN;
+    int maxY = INT32_MIN;
+    for (const auto& corner : corners) {
+        int x;
+        int y;
+        squareTileScreenToCoordRoof(corner[0], corner[1], elevation, &x, &y);
+        minX = std::min(minX, x);
+        minY = std::min(minY, y);
+        maxX = std::max(maxX, x);
+        maxY = std::max(maxY, y);
+    }
+    minX = std::max(0, minX - 1);
+    minY = std::max(0, minY - 1);
+    maxX = std::min(SQUARE_GRID_WIDTH - 1, maxX + 1);
+    maxY = std::min(SQUARE_GRID_HEIGHT - 1, maxY + 1);
+
+    struct Piece {
+        int square;
+        int fid;
+        bool visible;
+        Rect rect;
+        CacheEntry* handle;
+        const unsigned char* data;
+        RoofDamage fresh;
+        RoofDamage* damage;
+        std::vector<unsigned char> before;
+        std::vector<float> reach;
+    };
+    std::vector<Piece> pieces;
+
+    std::unordered_map<int, RoofDamage>& roofs = gDestructRoofs[gDestructMap];
+    int emptyFid = buildFid(OBJ_TYPE_TILE, 1, 0, 0, 0);
+
+    // In the order the game draws roofs, so that where squares overlap the
+    // one on top counts.
+    for (int squareY = minY; squareY <= maxY; squareY++) {
+        for (int squareX = minX; squareX <= maxX; squareX++) {
+            int square = squareY * SQUARE_GRID_WIDTH + squareX;
+            int roof = (_square[elevation]->field_0[square] >> 16) & 0xFFFF;
+            int fid = buildFid(OBJ_TYPE_TILE, roof & 0xFFF, 0, 0, 0);
+            if (fid == emptyFid) {
+                continue;
+            }
+
+            int roofX;
+            int roofY;
+            if (squareTileToRoofScreenXY(square, &roofX, &roofY, elevation) != 0) {
+                continue;
+            }
+
+            Piece piece;
+            Art* art = artLock(fid, &(piece.handle));
+            if (art == nullptr) {
+                continue;
+            }
+            int width = artGetWidth(art, 0, 0);
+            int height = artGetHeight(art, 0, 0);
+            piece.data = artGetFrameData(art, 0, 0);
+            piece.rect = { roofX, roofY, roofX + width - 1, roofY + height - 1 };
+            Rect overlap;
+            if (piece.data == nullptr || rectIntersection(&(piece.rect), &region, &overlap) != 0) {
+                artUnlock(piece.handle);
+                continue;
+            }
+
+            piece.square = square;
+            piece.fid = fid;
+            // Hidden while the player is under it.
+            piece.visible = (((roof & 0xF000) >> 12) & 0x01) == 0;
+            pieces.push_back(std::move(piece));
+        }
+    }
+
+    for (Piece& piece : pieces) {
+        int width = piece.rect.right - piece.rect.left + 1;
+        int height = piece.rect.bottom - piece.rect.top + 1;
+        auto it = roofs.find(elevation * SQUARE_GRID_SIZE + piece.square);
+        if (it != roofs.end() && it->second.fid == piece.fid && it->second.width == width && it->second.height == height) {
+            piece.damage = &(it->second);
+        } else {
+            piece.fresh.fid = piece.fid;
+            piece.fresh.width = width;
+            piece.fresh.height = height;
+            piece.fresh.mask.assign((size_t)width * height, 0);
+            piece.damage = &(piece.fresh);
+        }
+        piece.before = piece.damage->mask;
+        piece.reach.assign((size_t)width * height, 9.0f);
+
+        std::vector<unsigned char>& mask = piece.damage->mask;
+        for (int y = 0; y < height; y++) {
+            for (int x = 0; x < width; x++) {
+                size_t index = (size_t)y * width + x;
+                if (piece.data[index] == 0 || mask[index] == kGone) {
+                    continue;
+                }
+                // The ground under this bit of roof.
+                float groundX = (float)(piece.rect.left + x);
+                float groundY = (float)(piece.rect.top + y + kRoofHeight);
+                float dx = (groundX - blastX) / radius;
+                float dy = (groundY - blastY) * 2.0f / radius;
+                float rough = 0.6f * destructNoise(groundX, groundY, 7.0f, 31) + 0.4f * destructNoise(groundX, groundY, 1.8f, 32);
+                float distance = sqrtf(dx * dx + dy * dy) / (0.72f + 0.56f * rough);
+                piece.reach[index] = distance;
+                if (distance < 1.0f && destructFloorPixel((int)groundX, (int)groundY, elevation) != 0) {
+                    mask[index] = kGone;
+                }
+            }
+        }
+    }
+
+    // The roof as drawn over the region: which piece owns each pixel.
+    size_t regionSize = (size_t)regionWidth * regionHeight;
+    std::vector<int> owner(regionSize, -1);
+    for (int index = 0; index < (int)pieces.size(); index++) {
+        const Piece& piece = pieces[index];
+        int width = piece.rect.right - piece.rect.left + 1;
+        for (int y = std::max(piece.rect.top, region.top); y <= std::min(piece.rect.bottom, region.bottom); y++) {
+            for (int x = std::max(piece.rect.left, region.left); x <= std::min(piece.rect.right, region.right); x++) {
+                if (piece.data[(size_t)(y - piece.rect.top) * width + (x - piece.rect.left)] != 0) {
+                    owner[(size_t)(y - region.top) * regionWidth + (x - region.left)] = index;
+                }
+            }
+        }
+    }
+
+    std::vector<unsigned char> whole(regionSize, 0);
+    std::vector<unsigned char> alive(regionSize, 0);
+    std::vector<unsigned char> held(regionSize, 0);
+    std::vector<unsigned char> heldWhole(regionSize, 0);
+    auto local = [&](size_t index) {
+        const Piece& piece = pieces[owner[index]];
+        int width = piece.rect.right - piece.rect.left + 1;
+        int x = region.left + (int)(index % regionWidth) - piece.rect.left;
+        int y = region.top + (int)(index / regionWidth) - piece.rect.top;
+        return (size_t)y * width + x;
+    };
+    for (size_t index = 0; index < regionSize; index++) {
+        if (owner[index] == -1) {
+            continue;
+        }
+        int x = (int)(index % regionWidth);
+        int y = (int)(index / regionWidth);
+        bool edge = x == 0 || y == 0 || x == regionWidth - 1 || y == regionHeight - 1;
+        whole[index] = 1;
+        alive[index] = pieces[owner[index]].damage->mask[local(index)] != kGone;
+        heldWhole[index] = edge;
+        held[index] = edge && alive[index];
+    }
+    destructFlood(whole, regionWidth, regionHeight, heldWhole);
+    destructFlood(alive, regionWidth, regionHeight, held);
+    for (size_t index = 0; index < regionSize; index++) {
+        if (alive[index] && !held[index] && heldWhole[index]) {
+            pieces[owner[index]].damage->mask[local(index)] = kGone;
+        }
+    }
+
+    for (Piece& piece : pieces) {
+        int width = piece.rect.right - piece.rect.left + 1;
+        int height = piece.rect.bottom - piece.rect.top + 1;
+        std::vector<unsigned char>& mask = piece.damage->mask;
+        const unsigned char* data = piece.data;
+
+        auto isGone = [&](int x, int y) {
+            if (x < 0 || y < 0 || x >= width || y >= height) {
+                return false;
+            }
+            size_t index = (size_t)y * width + x;
+            return data[index] != 0 && mask[index] == kGone;
+        };
+
+        for (int y = 0; y < height; y++) {
+            for (int x = 0; x < width; x++) {
+                size_t index = (size_t)y * width + x;
+                if (data[index] == 0 || mask[index] == kGone) {
+                    continue;
+                }
+                int level = mask[index] != 0 ? mask[index] : 128;
+                if (piece.reach[index] < 1.8f) {
+                    float soot = std::clamp((1.8f - piece.reach[index]) / 1.0f, 0.0f, 1.0f);
+                    float patchy = 0.55f + 0.45f * destructNoise((float)(piece.rect.left + x), (float)(piece.rect.top + y), 4.0f, 33);
+                    level = std::min(level, 128 - (int)(80.0f * soot * patchy));
+                }
+                // The far side of the hole shows the roof's broken
+                // thickness, the near side a lit lip.
+                if (isGone(x, y + 1)) {
+                    level = std::min(level, 62);
+                } else if (isGone(x, y + 2)) {
+                    level = std::min(level, 86);
+                } else if (isGone(x, y - 1)) {
+                    level = 160;
+                } else if (isGone(x - 1, y) || isGone(x + 1, y)) {
+                    level = std::min(level, 80);
+                }
+                mask[index] = level == 128 ? 0 : (unsigned char)std::clamp(level, 1, 254);
+            }
+        }
+
+        DestructFrame removed;
+        removed.left = piece.rect.left;
+        removed.top = piece.rect.top;
+        removed.width = width;
+        removed.height = height;
+        removed.groundX = piece.rect.left + width / 2;
+        removed.groundY = piece.rect.bottom + kRoofHeight;
+        removed.pixels.assign((size_t)width * height, 0);
+        int gone = 0;
+        for (size_t index = 0; index < mask.size(); index++) {
+            if (mask[index] == kGone && piece.before[index] != kGone && data[index] != 0) {
+                removed.pixels[index] = data[index];
+                gone++;
+            }
+        }
+
+        bool changed = mask != piece.before;
+#ifdef WRECKED_TEST
+        if (gone > 0) {
+            fprintf(stderr, "destruct: roof square %d fid %08x at %d,%d visible %d: %d gone\n", piece.square, piece.fid, piece.rect.left, piece.rect.top, piece.visible ? 1 : 0, gone);
+        }
+#endif
+        if (changed) {
+            piece.damage->pixels.clear();
+            if (piece.damage == &(piece.fresh)) {
+                roofs[elevation * SQUARE_GRID_SIZE + piece.square] = std::move(piece.fresh);
+            }
+            if (*anyDirty) {
+                rectUnion(dirty, &(piece.rect), dirty);
+            } else {
+                *dirty = piece.rect;
+                *anyDirty = true;
+            }
+        }
+
+        if (gone > 0 && piece.visible) {
+            unsigned char colors[8];
+            destructFrameColors(removed, colors);
+            // Grey roofs are sheet metal, the rest boards and tar.
+            int r;
+            int g;
+            int b;
+            destructColorRgb(colors[4], &r, &g, &b);
+            DestructMaterial material = std::max({ r, g, b }) - std::min({ r, g, b }) < 20 ? DESTRUCT_METAL : DESTRUCT_WOOD;
+            destructShatter(removed, tile, elevation, 0.0f, 0.0f, power * 0.6f, false, material, true);
+            if (gone > 120) {
+                destructMaterialDebris(removed, tile, elevation, power * 0.4f, colors, material);
+            }
+        }
+    }
+
+    for (Piece& piece : pieces) {
+        artUnlock(piece.handle);
+    }
+}
+
+// Breaks scenery and walls in reach and returns the area to redraw.
+static void destructBreak(int tile, int elevation, int radius, int damage, float power, Rect* dirty, bool* anyDirty)
+{
+    if (destructMapBlocked() || (!gDestructConfig.walls && !gDestructConfig.scenery)) {
+        return;
+    }
+
+    std::vector<Object*> candidates;
+    int centerX = tile % HEX_GRID_WIDTH;
+    int centerY = tile / HEX_GRID_WIDTH;
+    for (int y = centerY - radius; y <= centerY + radius; y++) {
+        for (int x = centerX - radius; x <= centerX + radius; x++) {
+            if (x < 0 || y < 0 || x >= HEX_GRID_WIDTH || y >= HEX_GRID_HEIGHT) {
+                continue;
+            }
+            int other = y * HEX_GRID_WIDTH + x;
+            if (tileDistanceBetween(tile, other) > radius) {
+                continue;
+            }
+            for (Object* object = objectFindFirstAtLocation(elevation, other); object != nullptr; object = objectFindNextAtLocation()) {
+                if (std::find(candidates.begin(), candidates.end(), object) == candidates.end()) {
+                    candidates.push_back(object);
+                }
+            }
+        }
+    }
+
+    int blastX;
+    int blastY;
+    if (!destructTileCenter(tile, elevation, &blastX, &blastY)) {
+        return;
+    }
+
+    // Whether a wall gives way here: then walls in reach come down above the
+    // blast, not just around it.
+    bool wallBroken = false;
+    // How hard the blast hits the wall it hits hardest, against its strength:
+    // the hole is one shape across all the walls it reaches.
+    float wallRatio = 0.0f;
+    for (Object* object : candidates) {
+        if (FID_TYPE(object->fid) != OBJ_TYPE_WALL || object->sid != -1 || PID_TYPE(object->pid) != OBJ_TYPE_WALL || !gDestructConfig.walls) {
+            continue;
+        }
+        CacheEntry* handle;
+        Art* art = artLock(object->fid, &handle);
+        if (art == nullptr) {
+            continue;
+        }
+        int area = artGetWidth(art, object->frame, object->rotation) * artGetHeight(art, object->frame, object->rotation);
+        artUnlock(handle);
+        int distance = tileDistanceBetween(tile, object->tile);
+        if (!destructGroundAround(object->tile, elevation)) {
+            continue;
+        }
+        float ratio = (float)(damage * (radius + 1 - distance) / (radius + 1)) / (gDestructConfig.wallStrength + area / 400);
+        wallRatio = std::max(wallRatio, ratio);
+        wallBroken = wallBroken || ratio >= 1.0f;
+    }
+    float biteRadius = (15.0f + 21.0f * power) * std::clamp(0.4f + 0.6f * wallRatio, 0.45f, 1.15f);
+    // A wall came down: the roof over it goes too.
+    bool roofFall = false;
+
+    for (Object* object : candidates) {
+        int type = FID_TYPE(object->fid);
+        if (object->elevation != elevation || object->sid != -1 || (object->flags & OBJECT_HIDDEN) != 0 || object == gDude) {
+            continue;
+        }
+
+        // Flat scenery is rugs, puddles and the like; walls can be flat too.
+        bool wall = type == OBJ_TYPE_WALL;
+        if (!wall && (object->flags & OBJECT_FLAT) != 0) {
+            continue;
+        }
+        if (wall) {
+            if (!gDestructConfig.walls || PID_TYPE(object->pid) != OBJ_TYPE_WALL) {
+                continue;
+            }
+        } else if (type == OBJ_TYPE_SCENERY) {
+            Proto* proto;
+            if (!gDestructConfig.scenery || PID_TYPE(object->pid) != OBJ_TYPE_SCENERY || protoGetProto(object->pid, &proto) == -1 || proto->scenery.type != SCENERY_TYPE_GENERIC) {
+                continue;
+            }
+        } else {
+            continue;
+        }
+
+        DestructFrame frame;
+        if (!destructObjectFrame(object, &frame) || frame.width * frame.height > 170 * 170) {
+#ifdef WRECKED_TEST
+            fprintf(stderr, "destruct: kept %08x at %d: art %dx%d\n", object->fid, object->tile, frame.width, frame.height);
+#endif
+            continue;
+        }
+
+        int distance = tileDistanceBetween(tile, object->tile);
+        int received = damage * (radius + 1 - distance) / (radius + 1);
+        int strength = wall
+            ? gDestructConfig.wallStrength + frame.width * frame.height / 400
+            : gDestructConfig.sceneryStrength + frame.width * frame.height / 250;
+
+        // A hole in a wall with no floor behind it would open onto the black.
+        bool open = !wall || destructGroundAround(object->tile, elevation);
+        bool broken = received >= strength && open;
+        bool bitten = open && (wall ? wallRatio >= 0.5f : received * 2 >= strength);
+
+        // Out of reach of even the soot.
+        float reachX = biteRadius * 1.25f * 1.28f * 2.4f;
+        float reachY = biteRadius * 1.28f * 2.4f;
+        float nearX = std::clamp((float)blastX, (float)frame.left, (float)(frame.left + frame.width - 1)) - blastX;
+        float nearY = std::clamp((float)(blastY - 16), (float)frame.top, (float)(frame.top + frame.height - 1)) - (blastY - 16);
+        if (!broken && (nearX / reachX) * (nearX / reachX) + (nearY / reachY) * (nearY / reachY) >= 1.0f) {
+            continue;
+        }
+
+#ifdef WRECKED_TEST
+        fprintf(stderr, "destruct: %s %s %08x at %d (distance %d, %d against %d, material %d)\n", broken ? "broke" : (bitten ? "bit" : "sooted"), wall ? "wall" : "scenery", object->fid, object->tile, distance, received, strength, (int)destructObjectMaterial(object));
+#endif
+
+        unsigned char colors[8];
+        destructFrameColors(frame, colors);
+        DestructMaterial material = destructObjectMaterial(object);
+        float push = power * (radius + 1 - distance) / (radius + 1) + 0.4f;
+        Rect objectRect = { frame.left, frame.top, frame.left + frame.width - 1, frame.top + frame.height - 1 };
+        bool destroy = false;
+
+        // Big scenery (boarded doors, shelves, machines) breaks like walls do.
+        bool large = !wall && (frame.width * frame.height > 1600 || frame.height > 56);
+        if (broken && !wall && !large) {
+            // Small scenery goes to pieces whole.
+            destructShatter(frame, tile, elevation, 0.0f, 0.0f, push, false, material);
+            destructMaterialDebris(frame, tile, elevation, push, colors, material);
+            destructPile(frame, object->tile, elevation, colors, material);
+            destructDust(tile, elevation, frame, blastX, blastY, colors, destructDustCount(material, 2));
+            destructForgetDamage(object);
+            destroy = true;
+        } else {
+            DestructFrame removed;
+            bool collapse = (wall || large) && (bitten || broken) && (wallBroken || broken);
+            float standing = destructDamageObject(object, frame, (float)blastX, (float)(blastY - 16), wall || large ? biteRadius : 15.0f + 21.0f * power, bitten || (large && broken), collapse, material, &removed);
+            bool any = std::any_of(removed.pixels.begin(), removed.pixels.end(), [](unsigned char color) {
+                return color != 0;
+            });
+#ifdef WRECKED_TEST
+            fprintf(stderr, "destruct:   %08x art %dx%d at %d,%d, blast %d,%d radius %.1f nearest %.2f, removed %d, standing %.2f\n", object->fid, frame.width, frame.height, frame.left, frame.top, blastX, blastY - 16, biteRadius, gDebugNearest,
+                (int)std::count_if(removed.pixels.begin(), removed.pixels.end(), [](unsigned char color) { return color != 0; }), standing);
+#endif
+            if (any) {
+                destructShatter(removed, tile, elevation, 0.0f, 0.0f, push, wall, material);
+                destructMaterialDebris(removed, tile, elevation, push, colors, material);
+                destructDust(tile, elevation, frame, blastX, blastY, colors, destructDustCount(material, wall ? 4 : 2));
+                if (wall && collapse) {
+                    roofFall = true;
+                }
+            }
+            if (broken || standing < 0.45f) {
+                // What's left can be climbed over. A pile only for what came
+                // off now, so that later blasts don't stack them.
+                object->flags |= OBJECT_NO_BLOCK | OBJECT_SHOOT_THRU | OBJECT_LIGHT_THRU;
+                if (any) {
+                    destructPile(frame, object->tile, elevation, colors, material);
+                }
+            }
+            if (standing < 0.06f) {
+                destructForgetDamage(object);
+                destroy = true;
+            }
+        }
+
+        if (destroy) {
+            Rect lightRect;
+            if (object->lightIntensity > 0) {
+                objectSetLight(object, 0, 0, &lightRect);
+                rectUnion(&objectRect, &lightRect, &objectRect);
+            }
+            // As scripts destroy objects: whatever animates it stops first.
+            reg_anim_clear(object);
+            Rect destroyRect;
+            objectDestroy(object, &destroyRect);
+            rectUnion(&objectRect, &destroyRect, &objectRect);
+        }
+
+        if (*anyDirty) {
+            rectUnion(dirty, &objectRect, dirty);
+        } else {
+            *dirty = objectRect;
+            *anyDirty = true;
+        }
+    }
+
+#ifdef WRECKED_TEST
+    fprintf(stderr, "destruct: roof fall %d\n", roofFall ? 1 : 0);
+#endif
+    if (roofFall) {
+        destructBreakRoof(tile, elevation, blastX, blastY, biteRadius * 1.1f, power, dirty, anyDirty);
+    }
+}
+
+void destructExplode(int tile, int elevation, int radius, int damage, DestructBlast blast)
+{
+    if (!gDestructInitialized || !gDestructConfig.enabled || !tileIsValid(tile) || elevation < 0 || elevation >= ELEVATION_COUNT) {
+        return;
+    }
+
+    destructPrepareColors();
+
+    if (gBlastMeteor) {
+        radius = 4;
+        damage = 130;
+    }
+    radius = std::clamp(radius, 1, 6);
+    damage = std::max(damage, 1);
+    float power = std::clamp(damage / 40.0f, 0.5f, gBlastMeteor ? 3.0f : 2.0f);
+    float amount = gDestructConfig.debris / 100.0f;
+
+    int centerX;
+    int centerY;
+    if (!destructTileCenter(tile, elevation, &centerX, &centerY)) {
+        return;
+    }
+
+    Rect dirty = { centerX - 1, centerY - 1, centerX + 1, centerY + 1 };
+    bool anyDirty = true;
+
+    if (blast != DESTRUCT_BLAST_EMP) {
+        destructBreak(tile, elevation, radius, damage, power, &dirty, &anyDirty);
+    }
+
+    // The fireball: puffs thrown out and up that cool down into smoke.
+    if (blast != DESTRUCT_BLAST_EMP) {
+        int count = (int)(10 + 6 * power);
+        for (int index = 0; index < count; index++) {
+            const DestructSprite* sprite = destructSpriteVariant("puff");
+            if (sprite == nullptr) {
+                break;
+            }
+            Particle fire = destructNewParticle(PARTICLE_FIRE, tile, elevation);
+            fire.blast = blast;
+            fire.sprite = sprite;
+            fire.frame = destructPick(sprite->frames);
+            fire.x = destructBetween(-8.0f, 8.0f);
+            fire.y = destructBetween(-4.0f, 4.0f);
+            fire.z = destructBetween(2.0f, 14.0f);
+            float angle = destructBetween(0.0f, 6.2831853f);
+            float speed = destructBetween(30.0f, 95.0f) * power;
+            fire.vx = cosf(angle) * speed;
+            fire.vy = sinf(angle) * speed * 0.5f;
+            fire.vz = destructBetween(30.0f, 150.0f) * power;
+            fire.scale = destructBetween(0.3f, 0.5f) * power;
+            fire.growth = destructBetween(0.6f, 1.1f) * power;
+            fire.life = destructBetween(0.45f, 0.8f);
+            fire.delay = index < count / 2 ? 0.0f : destructBetween(0.0f, 0.12f);
+            fire.color = destructNearest(64, 60, 56);
+            destructAddParticle(std::move(fire));
+        }
+    }
+
+    // Sparks and embers.
+    int sparks = (int)(34 * power * amount) + 8;
+    for (int index = 0; index < sparks; index++) {
+        Particle spark = destructNewParticle(PARTICLE_SPARK, tile, elevation);
+        spark.blast = blast;
+        spark.variant = destructPick(5);
+        spark.x = destructBetween(-4.0f, 4.0f);
+        spark.z = destructBetween(4.0f, 16.0f);
+        float angle = destructBetween(0.0f, 6.2831853f);
+        float speed = destructBetween(110.0f, 380.0f) * sqrtf(power);
+        spark.vx = cosf(angle) * speed;
+        spark.vy = sinf(angle) * speed * 0.5f;
+        spark.vz = destructBetween(90.0f, 420.0f) * sqrtf(power);
+        spark.life = destructBetween(0.4f, 1.3f);
+        destructAddParticle(std::move(spark));
+    }
+
+    if (blast != DESTRUCT_BLAST_EMP) {
+        // Ground thrown up: pieces cut from the floor and chunks of its colors.
+        int pieces = (int)(18 * power * amount);
+        for (int index = 0; index < pieces; index++) {
+            Particle piece = destructNewParticle(PARTICLE_PIECE, tile, elevation);
+            piece.width = 2 + destructPick(5);
+            piece.height = 2 + destructPick(4);
+            piece.pixels.assign(piece.width * piece.height, 0);
+            int sourceX = centerX + (int)destructBetween(-16.0f, 16.0f);
+            int sourceY = centerY + (int)destructBetween(-8.0f, 8.0f);
+            bool any = false;
+            for (int y = 0; y < piece.height; y++) {
+                for (int x = 0; x < piece.width; x++) {
+                    float dx = (x + 0.5f) / piece.width - 0.5f;
+                    float dy = (y + 0.5f) / piece.height - 0.5f;
+                    if (dx * dx + dy * dy > 0.3f + (destructHash(x + index, y) & 7) * 0.02f) {
+                        continue;
+                    }
+                    unsigned char color = destructFloorPixel(sourceX + x, sourceY + y, elevation);
+                    piece.pixels[y * piece.width + x] = color;
+                    any = any || color != 0;
+                }
+            }
+            if (!any) {
+                continue;
+            }
+            piece.x = (float)(sourceX - centerX);
+            piece.y = (float)(sourceY - centerY);
+            destructLaunch(&piece, 0.0f, 0.0f, destructBetween(50.0f, 250.0f) * power, destructBetween(110.0f, 360.0f) * power);
+            piece.keep = true;
+            destructAddParticle(std::move(piece));
+        }
+
+        int chunks = (int)(10 * power * amount);
+        for (int index = 0; index < chunks; index++) {
+            const DestructSprite* sprite = destructSpriteVariant("rock");
+            unsigned char color = destructFloorPixel(centerX + (int)destructBetween(-20.0f, 20.0f), centerY + (int)destructBetween(-10.0f, 10.0f), elevation);
+            if (sprite == nullptr || color == 0 || color >= kGlowStart) {
+                continue;
+            }
+            Particle chunk = destructNewParticle(PARTICLE_CHUNK, tile, elevation);
+            chunk.sprite = sprite;
+            chunk.color = color;
+            chunk.x = destructBetween(-10.0f, 10.0f);
+            chunk.y = destructBetween(-5.0f, 5.0f);
+            chunk.frame = destructPick(sprite->frames);
+            chunk.spin = destructBetween(8.0f, 22.0f);
+            destructLaunch(&chunk, 0.0f, 0.0f, destructBetween(40.0f, 200.0f) * power, destructBetween(140.0f, 380.0f) * power);
+            chunk.keep = true;
+            destructAddParticle(std::move(chunk));
+        }
+
+        // Smoke that rises after the fire.
+        int smokes = (int)(4 + 3 * power);
+        for (int index = 0; index < smokes; index++) {
+            destructSmoke(tile, elevation, destructBetween(-14.0f, 14.0f), destructBetween(-6.0f, 6.0f), destructBetween(6.0f, 28.0f),
+                destructNearest(70, 66, 62), 0.55f, destructBetween(0.5f, 0.9f) * power, destructBetween(0.15f, 0.5f), destructBetween(2.4f, 4.0f));
+        }
+
+        // The crater, if there is ground for it and no crater there yet:
+        // stacked ones only get blacker.
+        bool cratered = false;
+        if (std::vector<Decal>* decals = destructCurrentDecals()) {
+            for (const Decal& decal : *decals) {
+                int x;
+                int y;
+                if (decal.kind == DECAL_SHADE && decal.elevation == elevation && destructTileCenter(decal.tile, elevation, &x, &y)
+                    && abs(x - centerX) < 18 && abs(y - centerY) < 9) {
+                    cratered = true;
+                    break;
+                }
+            }
+        }
+        if (gDestructConfig.craters && !cratered && destructFloorPixel(centerX, centerY, elevation) != 0 && !destructMapBlocked()) {
+            const char* size = power < 0.95f ? "craters" : (power < 1.45f ? "craterm" : "craterl");
+            std::string name;
+            const DestructSprite* sprite = destructSpriteVariant(size, &name);
+            if (sprite != nullptr) {
+                Decal crater;
+                crater.kind = DECAL_SHADE;
+                crater.elevation = elevation;
+                crater.tile = tile;
+                crater.x = 16 - sprite->anchorX;
+                crater.y = 8 - sprite->anchorY;
+                crater.sprite = name;
+                crater.frame = destructPick(sprite->frames);
+                memset(crater.colors, 0, sizeof(crater.colors));
+                crater.width = 0;
+                crater.height = 0;
+                crater.resolved = nullptr;
+                Rect craterRect = { centerX - sprite->anchorX, centerY - sprite->anchorY, centerX - sprite->anchorX + sprite->width - 1, centerY - sprite->anchorY + sprite->height - 1 };
+                rectUnion(&dirty, &craterRect, &dirty);
+                destructAddDecal(std::move(crater));
+            }
+        }
+    }
+
+    if (gDestructConfig.flash) {
+        Rect flashRect;
+        if (gFlashTile != -1 && gFlashElevation == elevation && destructFlashRect(&flashRect)) {
+            rectUnion(&dirty, &flashRect, &dirty);
+        }
+        gFlashTile = tile;
+        gFlashElevation = elevation;
+        gFlashAge = 0.0f;
+        gFlashRadius = 45.0f + 30.0f * power;
+        gFlashDirty = true;
+    }
+
+    if (gDestructConfig.shake && blast != DESTRUCT_BLAST_EMP) {
+        gShakeStart = SDL_GetTicks();
+        gShakeAmplitude = 1.5f + 2.5f * power;
+    }
+
+    gDestructLastTick = SDL_GetTicks();
+    if (anyDirty && elevation == gElevation) {
+        tileWindowRefreshRect(&dirty, elevation);
+    }
+}
+
+void* destructPrepare(int tile, int elevation, int radius, int damage, DestructBlast blast)
+{
+    if (!gDestructInitialized || !gDestructConfig.enabled) {
+        return nullptr;
+    }
+
+    PendingBlast* pending = &(gPending[gPendingNext]);
+    gPendingNext = (gPendingNext + 1) % kPendingCount;
+    pending->tile = tile;
+    pending->elevation = elevation;
+    pending->radius = radius;
+    pending->damage = damage;
+    pending->blast = blast;
+    pending->meteor = gBlastMeteor;
+    return pending;
+}
+
+int destructExplodeCallback(void* data, void* unused)
+{
+    PendingBlast* pending = (PendingBlast*)data;
+    if (pending != nullptr) {
+        gBlastMeteor = pending->meteor;
+        destructExplode(pending->tile, pending->elevation, pending->radius, pending->damage, pending->blast);
+        gBlastMeteor = false;
+    }
+    return 0;
+}
+
+// The point of the map window under the cursor; over a roof, the ground
+// the roof covers, which is drawn that much lower.
+static bool destructCursorGround(int* x, int* y, int elevation, float* lift = nullptr)
+{
+    int mouseX;
+    int mouseY;
+    mouseGetPosition(&mouseX, &mouseY);
+    Rect isoRect;
+    if (windowGetRect(gIsoWindow, &isoRect) != 0) {
+        return false;
+    }
+    *x = mouseX - isoRect.left;
+    *y = mouseY - isoRect.top;
+    if (*x < 0 || *y < 0 || *x >= gDestructWidth || *y >= gDestructHeight) {
+        return false;
+    }
+    // A hole broken in the roof is still aimed at as the roof, as what hits
+    // there is drawn at the roof.
+    bool roof = tileRoofCovers(mouseX, mouseY, elevation);
+    if (roof) {
+        *y += kRoofHeight;
+    }
+    if (lift != nullptr) {
+        *lift = roof ? (float)kRoofHeight : 0.0f;
+    }
+    return true;
+}
+
+// How far above this point of the ground what falls from the sky is drawn
+// hitting: the height of the roof over it, if there is one.
+static float destructRoofLift(int x, int y, int elevation)
+{
+    return tileRoofCovers(x, y - kRoofHeight, elevation) ? (float)kRoofHeight : 0.0f;
+}
+
+static bool destructBeamPoint(int* x, int* y)
+{
+    int anchorX;
+    int anchorY;
+    if (!destructTileCenter(gBeam.anchor, gBeam.elevation, &anchorX, &anchorY)) {
+        return false;
+    }
+    *x = anchorX + (int)floorf(gBeam.x);
+    *y = anchorY + (int)floorf(gBeam.y);
+    return true;
+}
+
+// Where the beam is drawn hitting.
+static bool destructBeamDrawPoint(int* x, int* y)
+{
+    if (!destructBeamPoint(x, y)) {
+        return false;
+    }
+    *y -= (int)lroundf(gBeam.lift);
+    return true;
+}
+
+static int destructBeamTile()
+{
+    int x;
+    int y;
+    if (!destructBeamPoint(&x, &y)) {
+        return -1;
+    }
+    return tileFromScreenXY(x, y, gBeam.elevation);
+}
+
+// How wide the column is now, 0 while it aims.
+static float destructBeamWidth()
+{
+    float t = gBeam.age - kBeamAim;
+    if (t < 0.0f) {
+        return 0.0f;
+    }
+    if (t < kBeamCharge) {
+        return 1.0f + t / kBeamCharge;
+    }
+    t -= kBeamCharge;
+    if (t < kBeamFire) {
+        float open = std::min(1.0f, t / 0.12f);
+        return 2.0f + open * (6.0f + 1.5f * sinf(gBeam.age * 47.0f) + destructRandom());
+    }
+    t -= kBeamFire;
+    return std::max(0.0f, 8.0f * (1.0f - t / kBeamFade));
+}
+
+static bool destructBeamRect(Rect* rect)
+{
+    int x;
+    int y;
+    if (!destructBeamDrawPoint(&x, &y)) {
+        return false;
+    }
+    rect->left = x - 44;
+    rect->right = x + 44;
+    rect->top = 0;
+    rect->bottom = y + 24;
+    return true;
+}
+
+static void destructBeamSound(const char* name)
+{
+    _gsound_play_sfx_file_volume(name, 0x7FFF);
+}
+
+void destructBeamAt(int tile, int elevation, int steerTile)
+{
+    if (!gDestructInitialized || !gDestructConfig.enabled || gBeam.active || !tileIsValid(tile)) {
+        return;
+    }
+
+    destructPrepareColors();
+    gBeam.active = true;
+    gBeam.steerTile = steerTile;
+    gBeam.elevation = elevation;
+    gBeam.anchor = tile;
+    gBeam.x = 0.0f;
+    gBeam.y = 0.0f;
+    gBeam.age = 0.0f;
+    gBeam.nextBlast = kBeamAim + kBeamCharge;
+    gBeam.sounds = 0;
+    gBeam.hasDrawn = false;
+    int x;
+    int y;
+    gBeam.lift = destructTileCenter(tile, elevation, &x, &y) ? destructRoofLift(x, y, elevation) : 0.0f;
+    gDestructLastTick = SDL_GetTicks();
+    destructBeamSound("wac1xxx1");
+}
+
+void destructGameUpdate()
+{
+    // The game's explosion enables the interface when it ends, so none while
+    // the game has it off: during an attack, another explosion or a scene.
+    bool uiFree = !gameUiIsDisabled();
+
+    if (gMeteorImpactTile != -1 && uiFree) {
+        int tile = gMeteorImpactTile;
+        gMeteorImpactTile = -1;
+        if (gMeteorImpactElevation == gElevation) {
+            // As the game's explosion, so that it throws people back.
+            gBlastMeteor = true;
+            if (actionExplode(tile, gMeteorImpactElevation, 40, 80, gDude, true) == -2) {
+                gMeteorImpactTile = tile;
+            }
+            gBlastMeteor = false;
+        }
+    }
+
+    if (gBeamBlasts.empty()) {
+        return;
+    }
+
+    std::vector<std::pair<int, int>> blasts;
+    blasts.swap(gBeamBlasts);
+    for (const auto& blast : blasts) {
+        if (blast.second == gElevation) {
+#ifdef WRECKED_TEST
+            int before = critterGetHitPoints(gDude);
+#endif
+            // The game plays one explosion at a time: the others while it
+            // goes only break things.
+            if (!uiFree || actionExplode(blast.first, blast.second, 20, 40, gDude, true) != 0) {
+                destructExplode(blast.first, blast.second, 2, 50, DESTRUCT_BLAST_FIRE);
+            }
+#ifdef WRECKED_TEST
+            fprintf(stderr, "destruct: beam blast at %d (player at %d, distance %d): player hp %d -> %d\n", blast.first, gDude->tile, tileDistanceBetween(blast.first, gDude->tile), before, critterGetHitPoints(gDude));
+#endif
+        }
+    }
+}
+
+static inline void destructBlend(unsigned char* dest, int r, int g, int b, int alpha)
+{
+    if (alpha <= 0) {
+        return;
+    }
+    if (alpha >= 255) {
+        *dest = destructColor(r, g, b);
+        return;
+    }
+    int under = Color2RGB(*dest);
+    int underR = ((under >> 10) & 0x1F) * 8;
+    int underG = ((under >> 5) & 0x1F) * 8;
+    int underB = (under & 0x1F) * 8;
+    *dest = destructColor(underR + (r - underR) * alpha / 255,
+        underG + (g - underG) * alpha / 255,
+        underB + (b - underB) * alpha / 255);
+}
+
+// Where the meteor is: ground pixels from the center of its tile, and its
+// height, `progress` from 0 (far up) to 1 (landed).
+static void destructMeteorPosition(float progress, float* x, float* y, float* z)
+{
+    *x = kMeteorFromX * (1.0f - progress);
+    *y = kMeteorFromY * (1.0f - progress);
+    *z = kMeteorHeight * (1.0f - progress);
+}
+
+static float destructMeteorProgress()
+{
+    // It speeds up as it falls.
+    float t = std::min(1.0f, gMeteor.age / kMeteorFall);
+    return t * (0.45f + 0.55f * t);
+}
+
+// Where the meteor is drawn hitting.
+static bool destructMeteorTarget(int* x, int* y)
+{
+    if (!destructTileCenter(gMeteor.tile, gMeteor.elevation, x, y)) {
+        return false;
+    }
+    *y -= (int)lroundf(gMeteor.lift);
+    return true;
+}
+
+static bool destructMeteorRect(Rect* rect)
+{
+    int targetX;
+    int targetY;
+    if (!destructMeteorTarget(&targetX, &targetY)) {
+        return false;
+    }
+    float x;
+    float y;
+    float z;
+    destructMeteorPosition(destructMeteorProgress(), &x, &y, &z);
+    int headX = targetX + (int)x;
+    int headY = targetY + (int)(y - z);
+    // The head, its tail back along the way it came, and the glow on the
+    // ground.
+    rect->left = std::min(headX - 24, targetX - 64);
+    rect->right = std::max(headX + 150, targetX + 64);
+    rect->top = std::max(0, headY - 150);
+    rect->bottom = std::max(headY + 24, targetY + 34);
+    return true;
+}
+
+static void destructMeteorLaunch(int tile, int elevation, float lift)
+{
+    if (!gDestructInitialized || !gDestructConfig.enabled || gMeteor.active || gMeteorImpactTile != -1 || !tileIsValid(tile)) {
+        return;
+    }
+
+    destructPrepareColors();
+    gMeteor.active = true;
+    gMeteor.elevation = elevation;
+    gMeteor.tile = tile;
+    gMeteor.lift = lift;
+    gMeteor.age = 0.0f;
+    gMeteor.hasDrawn = false;
+    gDestructLastTick = SDL_GetTicks();
+    destructBeamSound("wan1xxx1");
+}
+
+void destructMeteorAt(int tile, int elevation)
+{
+    int x;
+    int y;
+    if (destructTileCenter(tile, elevation, &x, &y)) {
+        destructMeteorLaunch(tile, elevation, destructRoofLift(x, y, elevation));
+    }
+}
+
+void destructMeteorAtCursor()
+{
+    if (!gDestructConfig.meteor) {
+        return;
+    }
+
+    int x;
+    int y;
+    float lift;
+    if (!destructCursorGround(&x, &y, gElevation, &lift)) {
+        return;
+    }
+
+    int tile = tileFromScreenXY(x, y, gElevation);
+    if (tile != -1) {
+        destructMeteorLaunch(tile, gElevation, lift);
+    }
+}
+
+// What the impact does besides the explosion: the roof over it caves in, a
+// ring of dust rushes out, rocks fly, and the meteor stays in its crater.
+static void destructMeteorImpact(Rect* dirty, bool* anyDirty)
+{
+    int tile = gMeteor.tile;
+    int elevation = gMeteor.elevation;
+    int centerX;
+    int centerY;
+    if (!destructTileCenter(tile, elevation, &centerX, &centerY)) {
+        return;
+    }
+
+    destructBeamSound("whn1xxx2");
+    destructBeamSound("whn1xxx1");
+
+    if (!destructMapBlocked()) {
+        destructBreakRoof(tile, elevation, centerX, centerY, 70.0f, 2.0f, dirty, anyDirty);
+    }
+
+    unsigned char dust = destructNearest(120, 108, 92);
+    unsigned char ground = destructFloorPixel(centerX, centerY, elevation);
+    if (ground != 0 && ground < kGlowStart) {
+        int r;
+        int g;
+        int b;
+        destructColorRgb(ground, &r, &g, &b);
+        dust = destructNearest(r + 30, g + 26, b + 20);
+    }
+
+    // The shock: a ring of dust thrown along the ground.
+    const DestructSprite* puff = destructSpriteVariant("puff");
+    for (int index = 0; puff != nullptr && index < 36; index++) {
+        float angle = index * 6.2831853f / 36.0f + destructBetween(-0.05f, 0.05f);
+        Particle smoke = destructNewParticle(PARTICLE_SMOKE, tile, elevation);
+        smoke.sprite = destructSpriteVariant("puff");
+        smoke.frame = destructPick(smoke.sprite->frames);
+        smoke.x = cosf(angle) * 12.0f;
+        smoke.y = sinf(angle) * 6.0f;
+        smoke.z = gMeteor.lift + destructBetween(2.0f, 8.0f);
+        float speed = destructBetween(240.0f, 320.0f);
+        smoke.vx = cosf(angle) * speed;
+        smoke.vy = sinf(angle) * speed * 0.5f;
+        smoke.vz = destructBetween(4.0f, 14.0f);
+        smoke.scale = destructBetween(0.5f, 0.7f);
+        smoke.growth = destructBetween(0.5f, 0.8f);
+        smoke.opacity = 0.6f;
+        smoke.color = dust;
+        smoke.life = destructBetween(1.6f, 2.4f);
+        destructAddParticle(std::move(smoke));
+    }
+
+    // Molten rock thrown high.
+    for (int index = 0; index < 26; index++) {
+        const DestructSprite* sprite = destructSpriteVariant("rock");
+        if (sprite == nullptr) {
+            break;
+        }
+        Particle chunk = destructNewParticle(PARTICLE_CHUNK, tile, elevation);
+        chunk.sprite = sprite;
+        chunk.color = index % 3 == 0 ? destructNearest(150, 70, 30) : destructNearest(52, 46, 44);
+        chunk.frame = destructPick(sprite->frames);
+        chunk.spin = destructBetween(8.0f, 20.0f);
+        chunk.x = destructBetween(-8.0f, 8.0f);
+        chunk.y = destructBetween(-4.0f, 4.0f);
+        chunk.z = gMeteor.lift;
+        destructLaunch(&chunk, 0.0f, 0.0f, destructBetween(80.0f, 300.0f), destructBetween(250.0f, 520.0f));
+        chunk.keep = true;
+        destructAddParticle(std::move(chunk));
+    }
+
+    // The meteor, in what is left of it.
+    std::string name;
+    const DestructSprite* sprite = destructSpriteVariant("pilel", &name);
+    if (sprite != nullptr && gDestructConfig.craters && !destructMapBlocked() && destructFloorPixel(centerX, centerY, elevation) != 0) {
+        Decal rock;
+        rock.kind = DECAL_PILE;
+        rock.elevation = elevation;
+        rock.tile = tile;
+        rock.x = 16 - sprite->anchorX;
+        rock.y = 8 - sprite->anchorY;
+        rock.sprite = name;
+        rock.frame = destructPick(sprite->frames);
+        int tones[8][3] = { { 22, 20, 20 }, { 34, 30, 28 }, { 46, 40, 36 }, { 60, 50, 44 }, { 110, 46, 20 }, { 72, 60, 52 }, { 40, 34, 32 }, { 150, 70, 24 } };
+        for (int index = 0; index < 8; index++) {
+            rock.colors[index] = destructNearest(tones[index][0], tones[index][1], tones[index][2]);
+        }
+        rock.width = 0;
+        rock.height = 0;
+        rock.resolved = nullptr;
+        destructAddDecal(std::move(rock));
+    }
+
+    if (gDestructConfig.flash) {
+        gFlashTile = tile;
+        gFlashElevation = elevation;
+        gFlashAge = 0.0f;
+        gFlashRadius = 160.0f;
+        gFlashDirty = true;
+    }
+    if (gDestructConfig.shake) {
+        gShakeStart = SDL_GetTicks();
+        gShakeAmplitude = 9.0f;
+    }
+
+    // The explosion itself, which hurts, from the game loop.
+    gMeteorImpactTile = tile;
+    gMeteorImpactElevation = elevation;
+}
