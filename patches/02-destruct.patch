+
+// The beam and the meteor over everything, roofs too: they come from above.
+void destructRenderSky(Rect* rect, int elevation)
+{
+    if (!gDestructInitialized || gDestructBuffer == nullptr) {
+        return;
+    }
+
+    if (gMeteor.active && gMeteor.elevation == elevation) {
+        destructRenderMeteor(rect);
+    }
+
+    if (!gBeam.active || gBeam.elevation != elevation) {
+        return;
+    }
+
+    Rect beamRect;
+    Rect clipped;
+    if (!destructBeamRect(&beamRect) || !destructClip(&beamRect, rect, &clipped)) {
+        return;
+    }
+
+    int pointX;
+    int pointY;
+    destructBeamDrawPoint(&pointX, &pointY);
+    float t = gBeam.age;
+    auto plot = [&](int x, int y, int r, int g, int b, int alpha) {
+        if (x >= clipped.left && x <= clipped.right && y >= clipped.top && y <= clipped.bottom) {
+            destructBlend(gDestructBuffer + y * gDestructPitch + x, r, g, b, alpha);
+        }
+    };
+
+    if (t < kBeamAim) {
+        // The designator: a dotted red line from the sky and a ring on the
+        // ground that closes in.
+        bool shown = (destructHash((int)(t * 30.0f), 7) & 3) != 0;
+        if (shown) {
+            for (int y = clipped.top; y <= std::min(clipped.bottom, pointY); y++) {
+                if (((y + (int)(t * 240.0f)) % 7) < 4) {
+                    plot(pointX, y, 255, 40, 30, 190);
+                }
+            }
+        }
+        float pulse = 0.5f + 0.5f * sinf(t * 18.0f);
+        float radius = 22.0f - 10.0f * (t / kBeamAim) + 2.0f * pulse;
+        for (int ring = 0; ring < 2; ring++) {
+            float r = radius - ring;
+            for (int step = 0; step < 128; step++) {
+                float angle = step * 6.2831853f / 128.0f;
+                // Four arcs that turn.
+                if ((((int)(angle * 8.0f / 6.2831853f + t * 6.0f)) & 1) != 0) {
+                    continue;
+                }
+                int x = pointX + (int)lroundf(cosf(angle) * r);
+                int y = pointY + (int)lroundf(sinf(angle) * r * 0.5f);
+                plot(x, y, 255, 40 + 60 * ring, 30 + 40 * ring, 240);
+            }
+        }
+        for (int d = -3; d <= 3; d++) {
+            plot(pointX + d, pointY, 255, 80, 60, d == 0 ? 255 : 200);
+            plot(pointX, pointY + d / 2, 255, 80, 60, 200);
+        }
+        return;
+    }
+
+    float width = destructBeamWidth();
+    if (width <= 0.0f) {
+        return;
+    }
+    float fading = t > kBeamAim + kBeamCharge + kBeamFire ? 1.0f - (t - kBeamAim - kBeamCharge - kBeamFire) / kBeamFade : 1.0f;
+    bool full = t >= kBeamAim + kBeamCharge;
+
+    // Glow on the ground around where it hits.
+    if (full) {
+        float glowX = 30.0f + 4.0f * sinf(t * 31.0f);
+        for (int y = std::max(clipped.top, pointY - 20); y <= std::min(clipped.bottom, pointY + 20); y++) {
+            for (int x = std::max(clipped.left, pointX - (int)glowX - 1); x <= std::min(clipped.right, pointX + (int)glowX + 1); x++) {
+                float dx = (x - pointX) / glowX;
+                float dy = (y - pointY) * 2.0f / glowX;
+                float d = dx * dx + dy * dy;
+                if (d >= 1.0f) {
+                    continue;
+                }
+                int alpha = (int)(fading * 200.0f * (1.0f - d) * (1.0f - d));
+                if (d < 0.08f) {
+                    destructBlend(gDestructBuffer + y * gDestructPitch + x, 255, 255, 235, (int)(fading * 255));
+                } else {
+                    destructBlend(gDestructBuffer + y * gDestructPitch + x, 255, 214, 130, alpha);
+                }
+            }
+        }
+    }
+
+    // The column: a white-hot core in a gold sheath that ripples.
+    for (int y = clipped.top; y <= std::min(clipped.bottom, pointY); y++) {
+        float ripple = sinf(y * 0.11f + t * 26.0f) * 0.8f + sinf(y * 0.031f - t * 9.0f) * 0.6f;
+        float half = width * (0.85f + 0.15f * sinf(y * 0.07f + t * 37.0f));
+        // A little wider where it meets the ground.
+        half += std::max(0.0f, 6.0f - (pointY - y) * 0.25f) * (full ? 1.0f : 0.3f);
+        float center = pointX + ripple * (full ? 1.0f : 0.4f);
+        int left = (int)floorf(center - half - 3.0f);
+        int right = (int)ceilf(center + half + 3.0f);
+        for (int x = std::max(left, clipped.left); x <= std::min(right, clipped.right); x++) {
+            float d = fabsf(x + 0.5f - center) / std::max(0.5f, half);
+            int alpha;
+            int r;
+            int g;
+            int b;
+            if (d < 0.35f) {
+                r = 255;
+                g = 255;
+                b = 240;
+                alpha = 255;
+            } else if (d < 1.0f) {
+                float k = (d - 0.35f) / 0.65f;
+                r = 255;
+                g = (int)(245 - 60 * k);
+                b = (int)(200 - 130 * k);
+                alpha = (int)(255 - 120 * k);
+            } else {
+                float k = std::min(1.0f, (d - 1.0f) / (3.0f / std::max(0.5f, half)));
+                r = 255;
+                g = 170;
+                b = 60;
+                alpha = (int)(110 * (1.0f - k));
+            }
+            if (!full && (destructHash(y, (int)(t * 40.0f)) & 1) != 0) {
+                alpha /= 2;
+            }
+            destructBlend(gDestructBuffer + y * gDestructPitch + x, r, g, b, (int)(alpha * fading));
+        }
+    }
+}
