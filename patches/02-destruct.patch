+static DestructMaterial destructObjectMaterial(Object* object)
+{
+    Proto* proto;
+    if (protoGetProto(object->pid, &proto) == -1) {
+        return DESTRUCT_STONE;
+    }
+    return destructMaterialFrom(PID_TYPE(object->pid) == OBJ_TYPE_WALL ? proto->wall.material : proto->scenery.field_2C);
+}
+
+// Eight colors of the art from its middle tones, darkest first.
+static void destructFrameColors(const DestructFrame& frame, unsigned char* colors)
+{
+    std::vector<std::pair<int, unsigned char>> samples;
+    for (int attempt = 0; attempt < 400 && samples.size() < 48; attempt++) {
+        unsigned char color = frame.pixels[destructPick((int)frame.pixels.size())];
+        if (color == 0 || color >= kGlowStart) {
+            continue;
+        }
+        int r;
+        int g;
+        int b;
+        destructColorRgb(color, &r, &g, &b);
+        samples.push_back({ r * 3 + g * 6 + b, color });
+    }
+
+    if (samples.empty()) {
+        for (int index = 0; index < 8; index++) {
+            colors[index] = destructNearest(90, 84, 76);
+        }
+        return;
+    }
+
+    std::sort(samples.begin(), samples.end());
+    for (int index = 0; index < 8; index++) {
+        float position = 0.2f + 0.65f * index / 7.0f;
+        colors[index] = samples[std::min(samples.size() - 1, (size_t)(position * samples.size()))].second;
+    }
+}
+
+static std::vector<Decal>* destructCurrentDecals()
+{
+    if (gDestructMap.empty()) {
+        return nullptr;
+    }
+    return &(gDestructDecals[gDestructMap]);
+}
+
+static void destructAddDecal(Decal&& decal)
+{
+    std::vector<Decal>* decals = destructCurrentDecals();
+    if (decals == nullptr || gDestructConfig.maxDecals == 0) {
+        return;
+    }
+
+    if (decal.kind != DECAL_PIXELS) {
+        decal.resolved = destructSprite(decal.sprite);
+        if (decal.resolved == nullptr) {
+            return;
+        }
+        decal.width = decal.resolved->width;
+        decal.height = decal.resolved->height;
+    }
+
+    decals->push_back(std::move(decal));
+
+    // Oldest debris goes first; craters and piles only once no debris is left.
+    if ((int)decals->size() > gDestructConfig.maxDecals) {
+        auto it = std::find_if(decals->begin(), decals->end(), [](const Decal& other) {
+            return other.kind == DECAL_PIXELS;
+        });
+        decals->erase(it != decals->end() ? it : decals->begin());
+    }
+}
+
+static bool destructDecalRect(const Decal& decal, Rect* rect)
+{
+    int x;
+    int y;
+    if (tileToScreenXY(decal.tile, &x, &y, decal.elevation) != 0) {
+        return false;
+    }
+    rect->left = x + decal.x;
+    rect->top = y + decal.y;
+    rect->right = rect->left + decal.width - 1;
+    rect->bottom = rect->top + decal.height - 1;
+    return true;
+}
+
+static bool destructClip(const Rect* rect, const Rect* bounds, Rect* clipped)
+{
+    Rect screen = { 0, 0, gDestructWidth - 1, gDestructHeight - 1 };
+    Rect temp;
+    if (rectIntersection(rect, bounds, &temp) != 0) {
+        return false;
+    }
+    return rectIntersection(&temp, &screen, clipped) == 0;
+}
+
+void destructRenderDecals(Rect* rect, int elevation)
+{
+    if (!gDestructInitialized || gDestructBuffer == nullptr) {
+        return;
+    }
+
+    auto it = gDestructDecals.find(gDestructMap);
+    if (it == gDestructDecals.end()) {
+        return;
+    }
+
+    for (const Decal& decal : it->second) {
+        if (decal.elevation != elevation) {
+            continue;
+        }
+
+        Rect decalRect;
+        Rect clipped;
+        if (!destructDecalRect(decal, &decalRect) || !destructClip(&decalRect, rect, &clipped)) {
+            continue;
+        }
+
+        if (decal.kind == DECAL_SHADE) {
+            const DestructSprite* sprite = decal.resolved;
+            int frame = std::min(decal.frame, sprite->frames - 1);
+            for (int y = clipped.top; y <= clipped.bottom; y++) {
+                unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+                for (int x = clipped.left; x <= clipped.right; x++) {
+                    const unsigned char* pixel = sprite->pixel(frame, x - decalRect.left, y - decalRect.top);
+                    int alpha = pixel[sprite->channels - 1];
+                    if (alpha == 0 || dest[x] >= kGlowStart) {
+                        continue;
+                    }
+                    int level = 128 + (pixel[0] - 128) * alpha / 255;
+                    dest[x] = intensityColorTable[dest[x]][std::clamp(level, 0, 255)];
+                }
+            }
+            continue;
+        }
+
+        int light = destructLightAt(elevation, decal.tile);
+
+        if (decal.kind == DECAL_PILE) {
+            const DestructSprite* sprite = decal.resolved;
+            int frame = std::min(decal.frame, sprite->frames - 1);
+            for (int y = clipped.top; y <= clipped.bottom; y++) {
+                unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+                for (int x = clipped.left; x <= clipped.right; x++) {
+                    const unsigned char* pixel = sprite->pixel(frame, x - decalRect.left, y - decalRect.top);
+                    if (pixel[sprite->channels - 1] < 128) {
+                        continue;
+                    }
+                    int chunk = sprite->channels == 3 ? pixel[1] : 0;
+                    unsigned char color = intensityColorTable[decal.colors[chunk & 7]][pixel[0]];
+                    dest[x] = destructLit(color, light);
+                }
+            }
+            continue;
+        }
+
+        for (int y = clipped.top; y <= clipped.bottom; y++) {
+            unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+            const unsigned char* source = decal.pixels.data() + (y - decalRect.top) * decal.width - decalRect.left;
+            for (int x = clipped.left; x <= clipped.right; x++) {
+                if (source[x] != 0) {
+                    dest[x] = destructLit(source[x], light);
+                }
+            }
+        }
+    }
+}
+
+// Pieces tumble in quarter turns: their size and pixels turned `frame` times.
+static void destructPieceSize(const Particle& particle, int* width, int* height)
+{
+    bool turned = (particle.frame & 1) != 0;
+    *width = turned ? particle.height : particle.width;
+    *height = turned ? particle.width : particle.height;
+}
+
+static inline unsigned char destructPiecePixel(const Particle& particle, int u, int v)
+{
+    int w = particle.width;
+    int h = particle.height;
+    switch (particle.frame & 3) {
+    case 1:
+        return particle.pixels[(h - 1 - u) * w + v];
+    case 2:
+        return particle.pixels[(h - 1 - v) * w + (w - 1 - u)];
+    case 3:
+        return particle.pixels[u * w + (w - 1 - v)];
+    default:
+        return particle.pixels[v * w + u];
+    }
+}
+
+static bool destructParticleRect(const Particle& particle, Rect* rect)
+{
+    int anchorX;
+    int anchorY;
+    if (!destructTileCenter(particle.anchor, particle.elevation, &anchorX, &anchorY)) {
+        return false;
+    }
+
+    int groundX = anchorX + (int)floorf(particle.x);
+    int groundY = anchorY + (int)floorf(particle.y);
+    int top = groundY - (int)floorf(particle.z);
+
+    switch (particle.kind) {
+    case PARTICLE_PIECE: {
+        int width;
+        int height;
+        destructPieceSize(particle, &width, &height);
+        rect->left = groundX - width / 2;
+        rect->top = top - height + 1;
+        rect->right = rect->left + width - 1;
+        rect->bottom = top;
+        return true;
+    }
+    case PARTICLE_CHUNK:
+        rect->left = groundX - particle.sprite->anchorX;
+        rect->top = top - particle.sprite->anchorY;
+        rect->right = rect->left + particle.sprite->width - 1;
+        rect->bottom = rect->top + particle.sprite->height - 1;
+        return true;
+    case PARTICLE_SPARK: {
+        int tailX = groundX - (int)(particle.vx * 0.015f);
+        int tailY = top - (int)((particle.vy - particle.vz) * 0.015f);
+        rect->left = std::min(groundX, tailX);
+        rect->right = std::max(groundX, tailX);
+        rect->top = std::min(top, tailY);
+        rect->bottom = std::max(top, tailY);
+        return true;
+    }
+    case PARTICLE_FIRE:
+    case PARTICLE_SMOKE: {
+        int width = std::max(1, (int)(particle.sprite->width * particle.scale));
+        int height = std::max(1, (int)(particle.sprite->height * particle.scale));
+        rect->left = groundX - width / 2;
+        rect->top = top - height / 2;
+        rect->right = rect->left + width - 1;
+        rect->bottom = rect->top + height - 1;
+        return true;
+    }
+    }
+
+    return false;
+}
+
+static void destructDrawLine(int x0, int y0, int x1, int y1, const Rect* clip, unsigned char head, unsigned char tail)
+{
+    int dx = abs(x1 - x0);
+    int dy = abs(y1 - y0);
+    int steps = std::max(dx, dy);
+    for (int step = 0; step <= steps; step++) {
+        int x = steps == 0 ? x0 : x0 + (x1 - x0) * step / steps;
+        int y = steps == 0 ? y0 : y0 + (y1 - y0) * step / steps;
+        if (x >= clip->left && x <= clip->right && y >= clip->top && y <= clip->bottom) {
+            gDestructBuffer[y * gDestructPitch + x] = step * 2 <= steps ? head : tail;
+        }
+    }
+}
+
+// A puff's shade and coverage between its pixels, so that it grows smoothly.
+static void destructSample(const DestructSprite* sprite, int frame, float x, float y, int* shade, int* alpha)
+{
+    x = std::clamp(x - 0.5f, 0.0f, sprite->width - 1.001f);
+    y = std::clamp(y - 0.5f, 0.0f, sprite->height - 1.001f);
+    int left = (int)x;
+    int top = (int)y;
+    int right = std::min(left + 1, sprite->width - 1);
+    int bottom = std::min(top + 1, sprite->height - 1);
+    float fx = x - left;
+    float fy = y - top;
+    const unsigned char* a = sprite->pixel(frame, left, top);
+    const unsigned char* b = sprite->pixel(frame, right, top);
+    const unsigned char* c = sprite->pixel(frame, left, bottom);
+    const unsigned char* d = sprite->pixel(frame, right, bottom);
+    int last = sprite->channels - 1;
+    float wa = (1 - fx) * (1 - fy);
+    float wb = fx * (1 - fy);
+    float wc = (1 - fx) * fy;
+    float wd = fx * fy;
+    *shade = (int)(a[0] * wa + b[0] * wb + c[0] * wc + d[0] * wd);
+    *alpha = (int)(a[last] * wa + b[last] * wb + c[last] * wc + d[last] * wd);
+}
+
+static void destructDrawParticle(const Particle& particle, Rect* rect, int light)
+{
+    Rect particleRect;
+    Rect clipped;
+    if (!destructParticleRect(particle, &particleRect) || !destructClip(&particleRect, rect, &clipped)) {
+        return;
+    }
+
+    switch (particle.kind) {
+    case PARTICLE_PIECE: {
+        // Glass glints as it turns.
+        int glint = particle.material == DESTRUCT_GLASS && ((int)(particle.age * 16.0f) + particle.variant) % 3 == 0 ? 200 : 128;
+        for (int y = clipped.top; y <= clipped.bottom; y++) {
+            unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+            for (int x = clipped.left; x <= clipped.right; x++) {
+                unsigned char color = destructPiecePixel(particle, x - particleRect.left, y - particleRect.top);
+                if (color != 0) {
+                    if (glint != 128 && color < kGlowStart) {
+                        color = intensityColorTable[color][glint];
+                    }
+                    dest[x] = destructLit(color, light);
+                }
+            }
+        }
+        break;
+    }
+    case PARTICLE_CHUNK: {
+        const DestructSprite* sprite = particle.sprite;
+        int frame = particle.frame % sprite->frames;
+        for (int y = clipped.top; y <= clipped.bottom; y++) {
+            unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+            for (int x = clipped.left; x <= clipped.right; x++) {
+                const unsigned char* pixel = sprite->pixel(frame, x - particleRect.left, y - particleRect.top);
+                if (pixel[sprite->channels - 1] >= 128) {
+                    dest[x] = destructLit(intensityColorTable[particle.color][pixel[0]], light);
+                }
+            }
+        }
+        break;
+    }
+    case PARTICLE_SPARK: {
+        int anchorX;
+        int anchorY;
+        destructTileCenter(particle.anchor, particle.elevation, &anchorX, &anchorY);
+        int x = anchorX + (int)floorf(particle.x);
+        int y = anchorY + (int)floorf(particle.y) - (int)floorf(particle.z);
+        int tailX = x - (int)(particle.vx * 0.015f);
+        int tailY = y - (int)((particle.vy - particle.vz) * 0.015f);
+        unsigned char head;
+        unsigned char tail;
+        if (particle.blast == DESTRUCT_BLAST_PLASMA) {
+            head = kSlime + particle.variant % 4;
+            tail = kSlime + (particle.variant + 2) % 4;
+        } else if (particle.blast == DESTRUCT_BLAST_EMP) {
+            head = kMonitors + particle.variant % 5;
+            tail = kMonitors + (particle.variant + 2) % 5;
+        } else {
+            head = kFireSlow + particle.variant % 5;
+            tail = kFireSlow + (particle.variant + 3) % 5;
+        }
+        destructDrawLine(x, y, tailX, tailY, &clipped, head, tail);
+        break;
+    }
+    case PARTICLE_FIRE: {
+        const DestructSprite* sprite = particle.sprite;
+        int width = particleRect.right - particleRect.left + 1;
+        int height = particleRect.bottom - particleRect.top + 1;
+        float heat = 1.0f - particle.age / particle.life;
+        float fade = std::min(1.0f, 2.2f * heat);
+        const unsigned char* ramp = gDestructRamp[particle.blast];
+        for (int y = clipped.top; y <= clipped.bottom; y++) {
+            unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+            float sourceY = (y - particleRect.top + 0.5f) * sprite->height / height;
+            for (int x = clipped.left; x <= clipped.right; x++) {
+                float sourceX = (x - particleRect.left + 0.5f) * sprite->width / width;
+                int shade;
+                int alpha;
+                destructSample(sprite, particle.frame, sourceX, sourceY, &shade, &alpha);
+                alpha = (int)(alpha * fade);
+                if (alpha <= 8) {
+                    continue;
+                }
+                float glow = std::clamp(heat * (0.35f + 0.9f * shade / 255.0f), 0.0f, 1.0f);
+                unsigned char color = ramp[(int)(glow * 31.0f)];
+                if (alpha >= 200) {
+                    dest[x] = glow > 0.86f && particle.blast == DESTRUCT_BLAST_FIRE ? kFireSlow + (int)(destructHash(x, y) % 5) : color;
+                    continue;
+                }
+                // Thin fire at the edges lets what is behind show through.
+                int r;
+                int g;
+                int b;
+                destructColorRgb(color, &r, &g, &b);
+                int under = Color2RGB(dest[x]);
+                int underR = ((under >> 10) & 0x1F) * 8;
+                int underG = ((under >> 5) & 0x1F) * 8;
+                int underB = (under & 0x1F) * 8;
+                dest[x] = destructColor(underR + (r - underR) * alpha / 200,
+                    underG + (g - underG) * alpha / 200,
+                    underB + (b - underB) * alpha / 200);
+            }
+        }
+        break;
+    }
+    case PARTICLE_SMOKE: {
+        const DestructSprite* sprite = particle.sprite;
+        int width = particleRect.right - particleRect.left + 1;
+        int height = particleRect.bottom - particleRect.top + 1;
+        float t = particle.age / particle.life;
+        float fade = std::min(1.0f, particle.age / 0.25f) * (t < 0.4f ? 1.0f : std::max(0.0f, 1.0f - (t - 0.4f) / 0.6f));
+        int opacity = (int)(particle.opacity * fade * 256.0f);
+        if (opacity <= 0) {
+            break;
+        }
+        int baseR;
+        int baseG;
+        int baseB;
+        destructColorRgb(particle.color, &baseR, &baseG, &baseB);
+        // Smoke takes the light of where it is.
+        int lightScale = std::max(light, 40);
+        for (int y = clipped.top; y <= clipped.bottom; y++) {
+            unsigned char* dest = gDestructBuffer + y * gDestructPitch;
+            float sourceY = (y - particleRect.top + 0.5f) * sprite->height / height;
+            for (int x = clipped.left; x <= clipped.right; x++) {
+                float sourceX = (x - particleRect.left + 0.5f) * sprite->width / width;
+                int shade;
+                int alpha;
+                destructSample(sprite, particle.frame, sourceX, sourceY, &shade, &alpha);
+                alpha = alpha * opacity >> 8;
+                if (alpha <= 4) {
+                    continue;
+                }
+                shade = (90 + shade) * lightScale / 128;
+                int r = baseR * shade >> 8;
+                int g = baseG * shade >> 8;
+                int b = baseB * shade >> 8;
+                int under = Color2RGB(dest[x]);
+                int underR = ((under >> 10) & 0x1F) * 8;
+                int underG = ((under >> 5) & 0x1F) * 8;
+                int underB = (under & 0x1F) * 8;
+                dest[x] = destructColor(underR + (r - underR) * alpha / 255,
+                    underG + (g - underG) * alpha / 255,
+                    underB + (b - underB) * alpha / 255);
+            }
+        }
+        break;
+    }
+    }
+}
+
+bool destructHasParticles(int elevation)
+{
+    gParticleOrder.clear();
+    if (!gDestructInitialized) {
+        return false;
+    }
+
+    for (size_t index = 0; index < gParticles.size(); index++) {
+        const Particle& particle = gParticles[index];
+        if (particle.elevation == elevation && particle.delay <= 0.0f && !particle.dead && particle.tile != -1) {
+            gParticleOrder.push_back({ particle.tile, (int)index });
+        }
+    }
+    std::sort(gParticleOrder.begin(), gParticleOrder.end());
+    return !gParticleOrder.empty();
+}
