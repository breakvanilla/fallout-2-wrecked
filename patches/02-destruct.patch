+static void destructMeteorStep(float dt, Rect* dirty, bool* anyDirty)
+{
+    auto addDirty = [&](const Rect& rect) {
+        if (*anyDirty) {
+            rectUnion(dirty, &rect, dirty);
+        } else {
+            *dirty = rect;
+            *anyDirty = true;
+        }
+    };
+
+    if (gMeteor.hasDrawn && gMeteor.elevation == gElevation) {
+        addDirty(gMeteor.drawn);
+    }
+
+    float before = destructMeteorProgress();
+    gMeteor.age += dt;
+    if (gMeteor.elevation != gElevation) {
+        gMeteor.active = false;
+        gMeteor.hasDrawn = false;
+        return;
+    }
+
+    if (gMeteor.age >= kMeteorFall) {
+        destructMeteorImpact(dirty, anyDirty);
+        gMeteor.active = false;
+        gMeteor.hasDrawn = false;
+        return;
+    }
+
+    // A rumble that grows as it comes.
+    float progress = destructMeteorProgress();
+    if (gDestructConfig.shake) {
+        gShakeStart = SDL_GetTicks();
+        gShakeAmplitude = std::max(gShakeAmplitude, 0.4f + 2.6f * progress);
+    }
+
+    // Fire and smoke left along the way.
+    const DestructSprite* sprite = destructSpriteVariant("puff");
+    for (int index = 0; sprite != nullptr && index < 3; index++) {
+        float x;
+        float y;
+        float z;
+        destructMeteorPosition(before + (progress - before) * (index + 0.5f) / 3.0f, &x, &y, &z);
+        Particle fire = destructNewParticle(index == 0 ? PARTICLE_FIRE : PARTICLE_SMOKE, gMeteor.tile, gMeteor.elevation);
+        fire.sprite = destructSpriteVariant("puff");
+        fire.frame = destructPick(fire.sprite->frames);
+        fire.x = x + destructBetween(-2.0f, 2.0f);
+        fire.y = y + destructBetween(-1.0f, 1.0f);
+        fire.z = gMeteor.lift + z + destructBetween(-2.0f, 2.0f);
+        fire.vx = destructBetween(-6.0f, 6.0f);
+        fire.vy = destructBetween(-3.0f, 3.0f);
+        fire.vz = destructBetween(-4.0f, 10.0f);
+        if (fire.kind == PARTICLE_FIRE) {
+            fire.scale = destructBetween(0.25f, 0.4f);
+            fire.growth = destructBetween(0.4f, 0.7f);
+            fire.life = destructBetween(0.3f, 0.5f);
+            fire.color = destructNearest(64, 60, 56);
+        } else {
+            fire.scale = destructBetween(0.3f, 0.45f);
+            fire.growth = destructBetween(0.35f, 0.6f);
+            fire.opacity = 0.45f;
+            fire.color = destructNearest(76, 72, 68);
+            fire.life = destructBetween(1.8f, 3.0f);
+        }
+        destructAddParticle(std::move(fire));
+    }
+
+    Rect rect;
+    if (destructMeteorRect(&rect)) {
+        gMeteor.drawn = rect;
+        gMeteor.hasDrawn = true;
+        addDirty(rect);
+    }
+}
