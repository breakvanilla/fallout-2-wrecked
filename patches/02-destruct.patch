+
+// The CRC of the slot's SAVE.DAT. DESTRUCT.DAT keeps it, so that one left
+// behind when the game was saved over without the mod is not loaded into the
+// new save.
+static uint32_t destructSaveChecksum(const char* directory)
+{
+    char path[COMPAT_MAX_PATH];
+    snprintf(path, sizeof(path), "%sSAVE.DAT", directory);
+
+    File* stream = fileOpen(path, "rb");
+    if (stream == nullptr) {
+        return 0;
+    }
+
+    uLong crc = crc32(0L, Z_NULL, 0);
+    unsigned char buffer[16384];
+    size_t read;
+    while ((read = fileRead(buffer, 1, sizeof(buffer), stream)) > 0) {
+        crc = crc32(crc, buffer, (uInt)read);
+    }
+    fileClose(stream);
+    return (uint32_t)crc;
+}
+
+void destructSave(const char* directory)
+{
+    if (!gDestructInitialized) {
+        return;
+    }
+
+    uint32_t checksum = destructSaveChecksum(directory);
+
+    char path[COMPAT_MAX_PATH];
+    snprintf(path, sizeof(path), "%sDESTRUCT.DAT", directory);
+
+    File* stream = fileOpen(path, "wb");
+    if (stream == nullptr) {
+        return;
+    }
+
+    uint32_t mapCount = 0;
+    for (const auto& entry : gDestructDecals) {
+        if (!entry.second.empty()) {
+            mapCount++;
+        }
+    }
+
+    fileWrite("DSV4", 1, 4, stream);
+    fileWrite(&checksum, 4, 1, stream);
+    fileWrite(&mapCount, 4, 1, stream);
+    for (const auto& entry : gDestructDecals) {
+        if (entry.second.empty()) {
+            continue;
+        }
+
+        uint16_t nameLength = (uint16_t)entry.first.size();
+        uint32_t count = (uint32_t)entry.second.size();
+        fileWrite(&nameLength, 2, 1, stream);
+        fileWrite(entry.first.data(), 1, nameLength, stream);
+        fileWrite(&count, 4, 1, stream);
+        for (const Decal& decal : entry.second) {
+            int32_t numbers[4] = { decal.elevation, decal.tile, decal.x, decal.y };
+            fileWrite(&(decal.kind), 1, 1, stream);
+            fileWrite(numbers, 4, 4, stream);
+            if (decal.kind == DECAL_PIXELS) {
+                uint16_t size[2] = { (uint16_t)decal.width, (uint16_t)decal.height };
+                fileWrite(size, 2, 2, stream);
+                fileWrite(decal.pixels.data(), 1, decal.pixels.size(), stream);
+            } else {
+                unsigned char length = (unsigned char)std::min<size_t>(decal.sprite.size(), 15);
+                uint16_t frame = (uint16_t)decal.frame;
+                fileWrite(&length, 1, 1, stream);
+                fileWrite(decal.sprite.data(), 1, length, stream);
+                fileWrite(&frame, 2, 1, stream);
+                fileWrite(decal.colors, 1, 8, stream);
+            }
+        }
+    }
+
+    uint32_t damageMapCount = 0;
+    for (const auto& entry : gDestructDamage) {
+        if (!entry.second.empty()) {
+            damageMapCount++;
+        }
+    }
+    fileWrite(&damageMapCount, 4, 1, stream);
+    for (const auto& entry : gDestructDamage) {
+        if (entry.second.empty()) {
+            continue;
+        }
+
+        uint16_t nameLength = (uint16_t)entry.first.size();
+        uint32_t count = (uint32_t)entry.second.size();
+        fileWrite(&nameLength, 2, 1, stream);
+        fileWrite(entry.first.data(), 1, nameLength, stream);
+        fileWrite(&count, 4, 1, stream);
+        for (const Damage& damage : entry.second) {
+            int32_t numbers[5] = { damage.elevation, damage.tile, damage.fid, damage.width, damage.height };
+            std::vector<unsigned char> packed(compressBound(damage.mask.size()));
+            uLongf packedSize = packed.size();
+            compress(packed.data(), &packedSize, damage.mask.data(), damage.mask.size());
+            uint32_t size = (uint32_t)packedSize;
+            fileWrite(numbers, 4, 5, stream);
+            fileWrite(&size, 4, 1, stream);
+            fileWrite(packed.data(), 1, size, stream);
+        }
+    }
+
+    uint32_t roofMapCount = 0;
+    for (const auto& entry : gDestructRoofs) {
+        if (!entry.second.empty()) {
+            roofMapCount++;
+        }
+    }
+    fileWrite(&roofMapCount, 4, 1, stream);
+    for (const auto& entry : gDestructRoofs) {
+        if (entry.second.empty()) {
+            continue;
+        }
+
+        uint16_t nameLength = (uint16_t)entry.first.size();
+        uint32_t count = (uint32_t)entry.second.size();
+        fileWrite(&nameLength, 2, 1, stream);
+        fileWrite(entry.first.data(), 1, nameLength, stream);
+        fileWrite(&count, 4, 1, stream);
+        for (const auto& roof : entry.second) {
+            const RoofDamage& damage = roof.second;
+            int32_t numbers[4] = { roof.first, damage.fid, damage.width, damage.height };
+            std::vector<unsigned char> packed(compressBound(damage.mask.size()));
+            uLongf packedSize = packed.size();
+            compress(packed.data(), &packedSize, damage.mask.data(), damage.mask.size());
+            uint32_t size = (uint32_t)packedSize;
+            fileWrite(numbers, 4, 4, stream);
+            fileWrite(&size, 4, 1, stream);
+            fileWrite(packed.data(), 1, size, stream);
+        }
+    }
+
+    fileClose(stream);
+}
+
+void destructLoad(const char* directory)
+{
+    destructClearEffects();
+    gDestructDecals.clear();
+    gDestructDamage.clear();
+    gDestructRoofs.clear();
+    gDamageIndexDirty = true;
+
+    if (!gDestructInitialized) {
+        return;
+    }
+
+    // Soot that loaded walls show needs the colors.
+    destructPrepareColors();
+
+    char path[COMPAT_MAX_PATH];
+    snprintf(path, sizeof(path), "%sDESTRUCT.DAT", directory);
+
+    File* stream = fileOpen(path, "rb");
+    if (stream == nullptr) {
+        return;
+    }
+
+    // DSV3 has no checksum.
+    char magic[4];
+    uint32_t checksum = 0;
+    uint32_t mapCount;
+    bool ok = fileRead(magic, 1, 4, stream) == 4 && memcmp(magic, "DSV", 3) == 0 && (magic[3] == '3' || magic[3] == '4');
+    if (ok && magic[3] == '4') {
+        ok = fileRead(&checksum, 4, 1, stream) == 1 && checksum == destructSaveChecksum(directory);
+    }
+    ok = ok && fileRead(&mapCount, 4, 1, stream) == 1;
+    for (uint32_t map = 0; ok && map < mapCount; map++) {
+        uint16_t nameLength;
+        uint32_t count;
+        char name[256];
+        ok = fileRead(&nameLength, 2, 1, stream) == 1 && nameLength < sizeof(name) && fileRead(name, 1, nameLength, stream) == nameLength && fileRead(&count, 4, 1, stream) == 1;
+        if (!ok) {
+            break;
+        }
+        name[nameLength] = '\0';
+
+        std::vector<Decal>& decals = gDestructDecals[name];
+        for (uint32_t index = 0; ok && index < count; index++) {
+            Decal decal;
+            int32_t numbers[4];
+            ok = fileRead(&(decal.kind), 1, 1, stream) == 1 && decal.kind <= DECAL_PIXELS && fileRead(numbers, 4, 4, stream) == 4;
+            if (!ok) {
+                break;
+            }
+            decal.elevation = numbers[0];
+            decal.tile = numbers[1];
+            decal.x = numbers[2];
+            decal.y = numbers[3];
+            decal.frame = 0;
+            decal.resolved = nullptr;
+            memset(decal.colors, 0, sizeof(decal.colors));
+            if (decal.kind == DECAL_PIXELS) {
+                uint16_t size[2];
+                ok = fileRead(size, 2, 2, stream) == 2 && size[0] <= 1024 && size[1] <= 1024;
+                if (!ok) {
+                    break;
+                }
+                decal.width = size[0];
+                decal.height = size[1];
+                decal.pixels.resize((size_t)decal.width * decal.height);
+                ok = fileRead(decal.pixels.data(), 1, decal.pixels.size(), stream) == decal.pixels.size();
+            } else {
+                unsigned char length;
+                char sprite[16];
+                uint16_t frame;
+                ok = fileRead(&length, 1, 1, stream) == 1 && length < sizeof(sprite) && fileRead(sprite, 1, length, stream) == length
+                    && fileRead(&frame, 2, 1, stream) == 1 && fileRead(decal.colors, 1, 8, stream) == 8;
+                if (!ok) {
+                    break;
+                }
+                sprite[length] = '\0';
+                decal.sprite = sprite;
+                decal.frame = frame;
+                decal.resolved = destructSprite(decal.sprite);
+                if (decal.resolved == nullptr) {
+                    continue;
+                }
+                decal.width = decal.resolved->width;
+                decal.height = decal.resolved->height;
+            }
+
+            if (ok && elevationIsValid(decal.elevation) && tileIsValid(decal.tile)) {
+                decals.push_back(std::move(decal));
+            }
+        }
+    }
+
+    uint32_t damageMapCount = 0;
+    if (ok && fileRead(&damageMapCount, 4, 1, stream) != 1) {
+        damageMapCount = 0;
+    }
+    for (uint32_t map = 0; ok && map < damageMapCount; map++) {
+        uint16_t nameLength;
+        uint32_t count;
+        char name[256];
+        ok = fileRead(&nameLength, 2, 1, stream) == 1 && nameLength < sizeof(name) && fileRead(name, 1, nameLength, stream) == nameLength && fileRead(&count, 4, 1, stream) == 1;
+        if (!ok) {
+            break;
+        }
+        name[nameLength] = '\0';
+
+        std::vector<Damage>& list = gDestructDamage[name];
+        for (uint32_t index = 0; ok && index < count; index++) {
+            int32_t numbers[5];
+            uint32_t size;
+            ok = fileRead(numbers, 4, 5, stream) == 5 && fileRead(&size, 4, 1, stream) == 1 && size < (1u << 24);
+            if (!ok || numbers[3] <= 0 || numbers[4] <= 0 || numbers[3] > 4096 || numbers[4] > 4096 || numbers[3] * numbers[4] > 1024 * 1024) {
+                ok = false;
+                break;
+            }
+            std::vector<unsigned char> packed(size);
+            ok = fileRead(packed.data(), 1, size, stream) == size;
+            if (!ok) {
+                break;
+            }
+            Damage damage;
+            damage.elevation = numbers[0];
+            damage.tile = numbers[1];
+            damage.fid = numbers[2];
+            damage.width = numbers[3];
+            damage.height = numbers[4];
+            damage.mask.resize((size_t)damage.width * damage.height);
+            uLongf length = damage.mask.size();
+            damage.frame = -1;
+            damage.rotation = -1;
+            if (uncompress(damage.mask.data(), &length, packed.data(), size) == Z_OK && length == damage.mask.size()) {
+                list.push_back(std::move(damage));
+            }
+        }
+    }
+
+    uint32_t roofMapCount = 0;
+    if (ok && fileRead(&roofMapCount, 4, 1, stream) != 1) {
+        roofMapCount = 0;
+    }
+    for (uint32_t map = 0; ok && map < roofMapCount; map++) {
+        uint16_t nameLength;
+        uint32_t count;
+        char name[256];
+        ok = fileRead(&nameLength, 2, 1, stream) == 1 && nameLength < sizeof(name) && fileRead(name, 1, nameLength, stream) == nameLength && fileRead(&count, 4, 1, stream) == 1;
+        if (!ok) {
+            break;
+        }
+        name[nameLength] = '\0';
+
+        std::unordered_map<int, RoofDamage>& roofs = gDestructRoofs[name];
+        for (uint32_t index = 0; ok && index < count; index++) {
+            int32_t numbers[4];
+            uint32_t size;
+            ok = fileRead(numbers, 4, 4, stream) == 4 && fileRead(&size, 4, 1, stream) == 1 && size < (1u << 20);
+            if (!ok || numbers[0] < 0 || numbers[0] >= ELEVATION_COUNT * SQUARE_GRID_SIZE || numbers[2] <= 0 || numbers[3] <= 0 || numbers[2] > 256 || numbers[3] > 256 || numbers[2] * numbers[3] > 256 * 256) {
+                ok = false;
+                break;
+            }
+            std::vector<unsigned char> packed(size);
+            ok = fileRead(packed.data(), 1, size, stream) == size;
+            if (!ok) {
+                break;
+            }
+            RoofDamage damage;
+            damage.fid = numbers[1];
+            damage.width = numbers[2];
+            damage.height = numbers[3];
+            damage.mask.resize((size_t)damage.width * damage.height);
+            uLongf length = damage.mask.size();
+            if (uncompress(damage.mask.data(), &length, packed.data(), size) == Z_OK && length == damage.mask.size()) {
+                roofs[numbers[0]] = std::move(damage);
+            }
+        }
+    }
+
+    fileClose(stream);
+}
+
+#ifdef WRECKED_TEST
+bool destructTestSnapshot(const char* path)
+{
+    if (gDestructBuffer == nullptr) {
+        return false;
+    }
+
+    FILE* stream = fopen(path, "wb");
+    if (stream == nullptr) {
+        return false;
+    }
+
+    int rowSize = (gDestructWidth * 3 + 3) & ~3;
+    uint32_t fileSize = 54 + rowSize * gDestructHeight;
+    unsigned char header[54] = { 'B', 'M' };
+    memcpy(header + 2, &fileSize, 4);
+    uint32_t offset = 54;
+    uint32_t infoSize = 40;
+    int32_t width = gDestructWidth;
+    int32_t height = gDestructHeight;
+    uint16_t planes = 1;
+    uint16_t bits = 24;
+    memcpy(header + 10, &offset, 4);
+    memcpy(header + 14, &infoSize, 4);
+    memcpy(header + 18, &width, 4);
+    memcpy(header + 22, &height, 4);
+    memcpy(header + 26, &planes, 2);
+    memcpy(header + 28, &bits, 2);
+    fwrite(header, 1, 54, stream);
+
+    // The palette as shown, with its animated entries.
+    unsigned char* palette = _getSystemPalette();
+    std::vector<unsigned char> row(rowSize, 0);
+    for (int y = gDestructHeight - 1; y >= 0; y--) {
+        for (int x = 0; x < gDestructWidth; x++) {
+            unsigned char color = gDestructBuffer[y * gDestructPitch + x];
+            row[x * 3] = (unsigned char)(palette[color * 3 + 2] * 4);
+            row[x * 3 + 1] = (unsigned char)(palette[color * 3 + 1] * 4);
+            row[x * 3 + 2] = (unsigned char)(palette[color * 3] * 4);
+        }
+        fwrite(row.data(), 1, rowSize, stream);
+    }
+    fclose(stream);
+    return true;
+}
+
+// Each damage mask of the map as a PGM: black gone, grey levels as drawn.
+void destructTestDumpDamage(const char* directory)
+{
+    std::vector<Damage>* list = destructCurrentDamage();
+    if (list == nullptr) {
+        return;
+    }
+    for (const Damage& damage : *list) {
+        char path[512];
+        snprintf(path, sizeof(path), "%s/damage_%08x_%d.pgm", directory, damage.fid, damage.tile);
+        FILE* stream = fopen(path, "wb");
+        if (stream == nullptr) {
+            continue;
+        }
+        fprintf(stream, "P5 %d %d 255\n", damage.width, damage.height);
+        for (unsigned char mark : damage.mask) {
+            unsigned char value = mark == kGone ? 0 : (mark == 0 ? 128 : mark / 2 + 1);
+            fputc(value, stream);
+        }
+        fclose(stream);
+    }
+}
+
+int destructTestDecalCount()
+{
+    auto it = gDestructDecals.find(gDestructMap);
+    return it != gDestructDecals.end() ? (int)it->second.size() : 0;
+}
+#endif
+
+} // namespace fallout
