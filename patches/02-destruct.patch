+// Art rendered in Blender: shade (128 is the color as is), then for piles a
+// chunk number picking one of the pile's colors, then coverage.
+typedef struct DestructSprite {
+    int frames;
+    int width;
+    int height;
+    int channels;
+    // The point that sits on the ground, from the top left.
+    int anchorX;
+    int anchorY;
+    std::vector<unsigned char> data;
+
+    const unsigned char* pixel(int frame, int x, int y) const
+    {
+        return &(data[(((size_t)frame * height + y) * width + x) * channels]);
