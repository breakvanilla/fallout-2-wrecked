+static void destructLoadConfig()
+{
+    gDestructConfig = DestructConfig();
+
+    Config config;
+    if (!configInit(&config)) {
+        return;
+    }
+
+    if (configRead(&config, "wrecked-fallout-2/wrecked.ini", false)) {
+        configGetBool(&config, "wrecked", "enabled", &(gDestructConfig.enabled));
+        configGetBool(&config, "wrecked", "walls", &(gDestructConfig.walls));
+        configGetBool(&config, "wrecked", "scenery", &(gDestructConfig.scenery));
+        configGetBool(&config, "wrecked", "craters", &(gDestructConfig.craters));
+        configGetBool(&config, "wrecked", "shake", &(gDestructConfig.shake));
+        configGetBool(&config, "wrecked", "flash", &(gDestructConfig.flash));
+        configGetBool(&config, "wrecked", "test_key", &(gDestructConfig.testKey));
+        configGetBool(&config, "wrecked", "beam", &(gDestructConfig.beam));
+        configGetBool(&config, "wrecked", "meteor", &(gDestructConfig.meteor));
+        configGetInt(&config, "wrecked", "wall_strength", &(gDestructConfig.wallStrength));
+        configGetInt(&config, "wrecked", "scenery_strength", &(gDestructConfig.sceneryStrength));
+        configGetInt(&config, "wrecked", "debris", &(gDestructConfig.debris));
+        configGetInt(&config, "wrecked", "max_decals", &(gDestructConfig.maxDecals));
+
+        char* blocked;
+        if (configGetString(&config, "wrecked", "blocked_maps", &blocked)) {
+            std::string list = blocked;
+            size_t start = 0;
+            while (start <= list.size()) {
+                size_t end = list.find(',', start);
+                if (end == std::string::npos) {
+                    end = list.size();
+                }
+                std::string name = destructMapKey(list.substr(start, end - start).c_str());
+                name.erase(std::remove(name.begin(), name.end(), ' '), name.end());
+                if (!name.empty()) {
+                    gDestructConfig.blockedMaps.push_back(name);
+                }
+                start = end + 1;
+            }
+        }
+    }
+
+    configFree(&config);
+
+    gDestructConfig.debris = std::clamp(gDestructConfig.debris, 0, 400);
+    gDestructConfig.maxDecals = std::clamp(gDestructConfig.maxDecals, 0, 20000);
+    gDestructConfig.wallStrength = std::clamp(gDestructConfig.wallStrength, 1, 1000);
+    gDestructConfig.sceneryStrength = std::clamp(gDestructConfig.sceneryStrength, 1, 1000);
+}
