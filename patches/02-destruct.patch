+static uint32_t destructHash(int x, int y)
+{
+    uint32_t value = (uint32_t)x * 374761393u + (uint32_t)y * 668265263u;
+    value = (value ^ (value >> 13)) * 1274126177u;
+    return value ^ (value >> 16);
+}
