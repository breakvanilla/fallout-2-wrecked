+// Whether the floor goes on all around the tile, so that taking away what
+// stands there doesn't open a hole into the black.
+static bool destructGroundAround(int tile, int elevation)
+{
+    int x;
+    int y;
+    if (!destructTileCenter(tile, elevation, &x, &y)) {
+        return false;
+    }
+
+    const int offsets[9][2] = { { 0, 0 }, { -32, -8 }, { 32, 8 }, { -32, 8 }, { 32, -8 }, { 0, -16 }, { 0, 16 }, { -48, 0 }, { 48, 0 } };
+    for (const auto& offset : offsets) {
+        if (destructFloorPixel(x + offset[0], y + offset[1], elevation) == 0) {
+            return false;
+        }
+    }
+    return true;
+}
