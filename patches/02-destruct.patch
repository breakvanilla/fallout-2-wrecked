+static void destructColorRgb(unsigned char color, int* r, int* g, int* b)
+{
+    *r = _cmap[color * 3] * 4;
+    *g = _cmap[color * 3 + 1] * 4;
+    *b = _cmap[color * 3 + 2] * 4;
+}
+
+// The palette's color closest to `r`, `g`, `b`: never transparent and never
+// one that glows.
+static unsigned char destructNearest(int r, int g, int b)
+{
+    int best = 1;
+    int bestDistance = INT32_MAX;
+    for (int index = 1; index < kGlowStart; index++) {
+        int pr;
+        int pg;
+        int pb;
+        destructColorRgb(index, &pr, &pg, &pb);
+        int distance = (pr - r) * (pr - r) * 3 + (pg - g) * (pg - g) * 4 + (pb - b) * (pb - b) * 2;
+        if (distance < bestDistance) {
+            bestDistance = distance;
+            best = index;
+        }
+    }
+    return (unsigned char)best;
+}
+
+static void destructPrepareColors()
+{
+    if (gDestructColorsReady) {
+        return;
+    }
+
+    for (int index = 0; index < 32768; index++) {
+        unsigned char color = _colorTable[index];
+        if (color == 0 || color >= kGlowStart) {
+            int r = ((index >> 10) & 0x1F) * 8 + 4;
+            int g = ((index >> 5) & 0x1F) * 8 + 4;
+            int b = (index & 0x1F) * 8 + 4;
+            color = destructNearest(r, g, b);
+        }
+        gDestructColorTable[index] = color;
+    }
+
+    for (int blast = 0; blast < 3; blast++) {
+        for (int index = 0; index < 32; index++) {
+            float position = (1.0f - index / 31.0f) * 5.0f;
+            int key = std::min(4, (int)position);
+            float t = position - key;
+            int rgb[3];
+            for (int channel = 0; channel < 3; channel++) {
+                rgb[channel] = (int)(kRampKeys[blast][key][channel] * (1.0f - t) + kRampKeys[blast][key + 1][channel] * t);
+            }
+            gDestructRamp[blast][index] = destructNearest(rgb[0], rgb[1], rgb[2]);
+        }
+    }
+
+    gDestructDark = destructNearest(8, 8, 8);
+    gDestructColorsReady = true;
+}
+
+static inline unsigned char destructColor(int r, int g, int b)
+{
+    r = std::clamp(r, 0, 255);
+    g = std::clamp(g, 0, 255);
+    b = std::clamp(b, 0, 255);
+    return gDestructColorTable[((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)];
+}
+
+static inline unsigned char destructLit(unsigned char color, int light)
+{
+    return color < kGlowStart ? intensityColorTable[color][light] : color;
+}
