+static void destructPile(const DestructFrame& frame, int tile, int elevation, const unsigned char* colors, DestructMaterial material)
+{
+    // Glass leaves only its glints.
+    if (material == DESTRUCT_GLASS) {
+        return;
+    }
+    const char* kinds[] = { "pile", "pilew", "pilem", "", "pilec" };
+    std::string prefix = std::string(kinds[material]) + (frame.width >= 44 ? "l" : "s");
+    std::string name;
+    const DestructSprite* sprite = destructSpriteVariant(prefix.c_str(), &name);
+    if (sprite == nullptr) {
+        sprite = destructSpriteVariant(frame.width >= 44 ? "pilel" : "piles", &name);
+    }
+    if (sprite == nullptr) {
+        return;
+    }
+
+    Decal pile;
+    pile.kind = DECAL_PILE;
+    pile.elevation = elevation;
+    pile.tile = tile;
+    pile.x = 16 - sprite->anchorX + (int)destructBetween(-3.0f, 3.0f);
+    pile.y = 8 - sprite->anchorY + (int)destructBetween(-2.0f, 2.0f);
+    pile.sprite = name;
+    pile.frame = destructPick(sprite->frames);
+    memcpy(pile.colors, colors, sizeof(pile.colors));
+    pile.width = 0;
+    pile.height = 0;
+    pile.resolved = nullptr;
+    destructAddDecal(std::move(pile));
+}
