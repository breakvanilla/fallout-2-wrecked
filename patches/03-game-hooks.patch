+// Whether the roof, ignoring holes broken in it, covers this point of the map
+// window. Roof tiles overlap, so neighbouring squares are checked too.
+bool tileRoofCovers(int x, int y, int elevation)
+{
+    if (!gTileRoofIsVisible) {
+        return false;
+    }
+
+    int centerX;
+    int centerY;
+    squareTileScreenToCoordRoof(x, y, elevation, &centerX, &centerY);
+    int gridHeight = gSquareGridSize / gSquareGridWidth;
+    for (int tileY = centerY - 2; tileY <= centerY + 2; tileY++) {
+        for (int tileX = centerX - 2; tileX <= centerX + 2; tileX++) {
+            if (tileX < 0 || tileX >= gSquareGridWidth || tileY < 0 || tileY >= gridHeight) {
+                continue;
+            }
+
+            int idx = gSquareGridWidth * tileY + tileX;
+            int upper = gTileSquares[elevation]->field_0[idx] >> 16;
+            int fid = buildFid(OBJ_TYPE_TILE, upper & 0xFFF, 0, 0, 0);
+            if (fid == buildFid(OBJ_TYPE_TILE, 1, 0, 0, 0) || (((upper & 0xF000) >> 12) & 1) != 0) {
+                continue;
+            }
+
+            bool covered = false;
+            CacheEntry* handle;
+            Art* art = artLock(fid, &handle);
+            if (art != nullptr) {
+                unsigned char* data = artGetFrameData(art, 0, 0);
+                int width = artGetWidth(art, 0, 0);
+                int height = artGetHeight(art, 0, 0);
+                int roofX;
+                int roofY;
+                squareTileToRoofScreenXY(idx, &roofX, &roofY, elevation);
+                int px = x - roofX;
+                int py = y - roofY;
+                if (data != nullptr && px >= 0 && px < width && py >= 0 && py < height) {
+                    covered = data[width * py + px] != 0;
+                }
+                artUnlock(handle);
+            }
+            if (covered) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
