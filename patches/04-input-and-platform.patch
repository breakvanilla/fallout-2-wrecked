+#if __APPLE__ && TARGET_OS_OSX
+// Wrecked Fallout 2: the folder the app is in, also when macOS runs a
+// downloaded app from a read-only copy (App Translocation). The Security
+// framework's functions for that are not in its headers.
+static bool macAppFolder(char* path, size_t size)
+{
+    CFURLRef bundle = CFBundleCopyBundleURL(CFBundleGetMainBundle());
+    if (bundle == nullptr) {
+        return false;
+    }
+
+    CFURLRef app = bundle;
+    void* security = dlopen("/System/Library/Frameworks/Security.framework/Security", RTLD_LAZY);
+    if (security != nullptr) {
+        typedef Boolean (*IsTranslocatedProc)(CFURLRef, bool*, CFErrorRef*);
+        typedef CFURLRef (*OriginalPathProc)(CFURLRef, CFErrorRef*);
+        IsTranslocatedProc isTranslocated = (IsTranslocatedProc)dlsym(security, "SecTranslocateIsTranslocatedURL");
+        OriginalPathProc originalPath = (OriginalPathProc)dlsym(security, "SecTranslocateCreateOriginalPathForURL");
+        bool translocated = false;
+        if (isTranslocated != nullptr && originalPath != nullptr && isTranslocated(bundle, &translocated, nullptr) && translocated) {
+            CFURLRef original = originalPath(bundle, nullptr);
+            if (original != nullptr) {
+                app = original;
+            }
+        }
+    }
+
+    CFURLRef folder = CFURLCreateCopyDeletingLastPathComponent(nullptr, app);
+    bool found = folder != nullptr && CFURLGetFileSystemRepresentation(folder, true, (UInt8*)path, size);
+    if (folder != nullptr) {
+        CFRelease(folder);
+    }
+    if (app != bundle) {
+        CFRelease(app);
+    }
+    CFRelease(bundle);
+    return found;
+}
+#endif
