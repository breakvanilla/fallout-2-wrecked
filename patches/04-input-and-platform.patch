+// Wrecked Fallout 2: in relative mode macOS freezes the system cursor, and
+// SDL drops clicks whose frozen position is outside the window (fullscreen
+// black bars, the menu bar by the notch), so keep it mid-window.
+static void mouseKeepSystemCursorInWindow()
+{
+#ifdef WRECKED_TEST
+    // Test runs are hidden and must leave the user's cursor alone.
+    return;
+#endif
+
+    if (!SDL_GetRelativeMouseMode()) {
+        return;
+    }
+
+    SDL_Window* window = SDL_GetKeyboardFocus();
+    if (window == nullptr) {
+        return;
+    }
+
+    int windowX;
+    int windowY;
+    int windowWidth;
+    int windowHeight;
+    SDL_GetWindowPosition(window, &windowX, &windowY);
+    SDL_GetWindowSize(window, &windowWidth, &windowHeight);
+
+    int x;
+    int y;
+    SDL_GetGlobalMouseState(&x, &y);
+
+    const int margin = windowWidth / 4;
+    if (x < windowX + margin || x >= windowX + windowWidth - margin
+        || y < windowY + windowHeight / 4 || y >= windowY + windowHeight - windowHeight / 4) {
+        // `SDL_WarpMouseInWindow` only updates SDL's own position in
+        // relative mode, the global warp moves the system cursor.
+        SDL_WarpMouseGlobal(windowX + windowWidth / 2, windowY + windowHeight / 2);
+    }
+}
