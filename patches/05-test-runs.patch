+#ifdef WRECKED_TEST
+// Puts a new item into the player's inventory and takes it off the map, as
+// the scripts' add_obj_to_inven does, so a map change does not free it.
+static int destructTestGive(Object* item, int count)
+{
+    int rc = itemAdd(gDude, item, count);
+    if (rc == 0) {
+        Rect rect;
+        _obj_disconnect(item, &rect);
+    }
+    return rc;
+}
+
+// Wears armor `DESTRUCT_WEAR` with its art, as the inventory does: some
+// weapons (rocket launchers) have art only with armor.
+static void destructTestWear()
+{
+    Object* armor;
+    if (getenv("DESTRUCT_WEAR") == nullptr || objectCreateWithPid(&armor, atoi(getenv("DESTRUCT_WEAR"))) != 0) {
+        return;
+    }
+    destructTestGive(armor, 1);
+    Object* old = critterGetArmor(gDude);
+    if (old != nullptr) {
+        old->flags &= ~OBJECT_WORN;
+    }
+    armor->flags |= OBJECT_WORN;
+    _adjust_ac(gDude, old, armor);
+    int art = critterGetStat(gDude, STAT_GENDER) == GENDER_FEMALE ? armorGetFemaleFid(armor) : armorGetMaleFid(armor);
+    Rect rect;
+    fprintf(stderr, "destruct: wear %d art %d: %d\n", armor->pid, art, objectSetFid(gDude, buildFid(OBJ_TYPE_CRITTER, art, 0, 0, gDude->rotation + 1), &rect));
+}
+#endif
